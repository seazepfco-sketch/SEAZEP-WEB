---
const active = Astro.props.active || "";
---

<header class="site-header">
  <a class="brand" href="/">
    <img src="/assets/seazep-logo.png" alt="SEAZEP Agua y Energía" />
    <span>
      <strong>SEAZEP S.A. De C.V.</strong>
      <small>Agua · Energía · Tecnología</small>
    </span>
  </a>

  <nav class="main-nav" aria-label="Navegación principal">
    <a class={active === "inicio" ? "active" : ""} href="/">Inicio</a>
    <a class={active === "servicios" ? "active" : ""} href="/servicios">Servicios</a>
    <a class={active === "softwares" ? "active" : ""} href="/softwares">Softwares</a>
    <a class={active === "recursos" ? "active" : ""} href="/recursos">Recursos</a>
    <a class={active === "contacto" ? "active" : ""} href="/contacto">Contacto</a>
    <div class="admin-nav-dropdown" id="headerAdminButton" hidden>
  <button class={active === "admin" ? "active admin-nav-trigger" : "admin-nav-trigger"} type="button">
    Panel ADM
  </button>

  <div class="admin-nav-menu" aria-label="Menú administrativo SEAZEP">
    <a href="/admin/dashboard">Dashboard principal</a>
    <a href="/admin/licencias">Licencias</a>
    <a href="/admin/generar-licencia">Generar licencia</a>
    <a href="/admin/empresas">Empresas</a>
    <a href="/admin/usuarios">Usuarios</a>
    <a href="/admin/manuales">Manuales</a>
    <a href="/admin/descargas-manuales">Descargas manuales</a>

    <button class="admin-nav-logout" type="button" id="headerAdminLogoutButton">Cerrar sesión ADM</button>

  </div>
</div>


  </nav>

  <div class="nav-actions">
    <div class="header-user-box" id="headerUserBox" hidden>
  <div class="header-user-info">
    <strong id="headerUserName">Usuario</strong>
    <small id="headerUserEmail">correo@ejemplo.com</small>
  </div>

  <button class="header-logout-btn" type="button" id="headerLogoutButton">
    Cerrar sesión
  </button>
</div>

    <a class="btn btn-ghost" href="/acceso" id="headerAccessButton">Acceso</a>
    <a class="btn btn-ghost" href="/registro" id="headerRegisterButton">
  Crear cuenta
</a>
    <a class="btn btn-primary" href="/solicitar-demo">Solicitar información</a>
  </div>



  <script>
  const headerUserBox = document.getElementById("headerUserBox");
  const headerUserName = document.getElementById("headerUserName");
  const headerUserEmail = document.getElementById("headerUserEmail");
  const headerLogoutButton = document.getElementById("headerLogoutButton");
  const headerAccessButton = document.getElementById("headerAccessButton");
  const headerAdminButton = document.getElementById("headerAdminButton");
  const headerAdminLogoutButton = document.getElementById("headerAdminLogoutButton");
  const headerRegisterButton = document.getElementById("headerRegisterButton");



  function getStoredSeazepUser() {
    try {
      const rawUser = localStorage.getItem("seazep_user");
      const token = localStorage.getItem("seazep_session_token");
      const expiresAt = localStorage.getItem("seazep_session_expires_at");

      if (!rawUser || !token || !expiresAt) {
        return null;
      }

      const expiresDate = new Date(expiresAt);

      if (Number.isNaN(expiresDate.getTime()) || expiresDate <= new Date()) {
        localStorage.removeItem("seazep_user");
        localStorage.removeItem("seazep_session_token");
        localStorage.removeItem("seazep_session_expires_at");
        return null;
      }

      return JSON.parse(rawUser);
    } catch {
      return null;
    }
  }

  function renderHeaderSession() {
    const user = getStoredSeazepUser();
    const hasAdminSession = localStorage.getItem("admin_session") === "active";

    if (!user) {
  if (headerUserBox) headerUserBox.hidden = true;
  if (headerAccessButton) headerAccessButton.hidden = false;
  if (headerRegisterButton) headerRegisterButton.hidden = false;
  if (headerAdminButton) headerAdminButton.hidden = !hasAdminSession;
  return;
}

    if (headerAdminButton) {
      headerAdminButton.hidden = true;
    }


    if (headerUserName) {
      headerUserName.textContent = user.fullName || "Usuario SEAZEP";
    }

    if (headerUserEmail) {
      headerUserEmail.textContent = user.email || "";
    }

    if (headerUserBox) {
      headerUserBox.hidden = false;
    }

    if (headerAccessButton) {
      headerAccessButton.hidden = true;
    }


    if (headerRegisterButton) {
  headerRegisterButton.hidden = true;
}
  }

  headerLogoutButton?.addEventListener("click", () => {
    localStorage.removeItem("seazep_user");
    localStorage.removeItem("seazep_session_token");
    localStorage.removeItem("seazep_session_expires_at");

    window.location.href = "/acceso";
  });

  headerAdminLogoutButton?.addEventListener("click", () => {
  localStorage.removeItem("admin_session");
  localStorage.removeItem("seazep_admin_api_key");

  if (headerAdminButton) {
    headerAdminButton.hidden = true;
  }

  window.location.href = "/acceso";
});

  renderHeaderSession();
</script>



</header>

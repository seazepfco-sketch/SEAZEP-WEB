    function csvValue(value) {
      const text = String(value ?? "")
        .replaceAll("\r", " ")
        .replaceAll("\n", " ")
        .trim();

      return `"${text.replaceAll('"', '""')}"`;
    }

    function buildCsv(headers = [], rows = []) {
      const headerLine = headers.map(csvValue).join(",");
      const rowLines = rows.map((row) => {
        return headers.map((header) => csvValue(row[header])).join(",");
      });

      return [headerLine, ...rowLines].join("\n");
    }

    function downloadCsv(filename, csvContent) {
      const blob = new Blob([`\uFEFF${csvContent}`], {
        type: "text/csv;charset=utf-8;"
      });

      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");

      link.href = url;
      link.download = filename;
      document.body.appendChild(link);
      link.click();

      document.body.removeChild(link);
      URL.revokeObjectURL(url);
    }

    function getReportDateSuffix() {
      const now = new Date();

      const year = now.getFullYear();
      const month = String(now.getMonth() + 1).padStart(2, "0");
      const day = String(now.getDate()).padStart(2, "0");
      const hour = String(now.getHours()).padStart(2, "0");
      const minute = String(now.getMinutes()).padStart(2, "0");

      return `${year}-${month}-${day}_${hour}-${minute}`;
    }

    async function fetchAdminReport(url) {
      const adminKey = getAdminKey();

      if (!adminKey) {
        throw new Error("Ingrese la clave ADM antes de descargar reportes.");
      }

      const response = await fetch(url, {
        method: "GET",
        mode: "cors",
        headers: {
          "x-admin-key": adminKey
        }
      });

      const result = await response.json();

      if (!response.ok || !result.ok) {
        throw new Error(result.message || "No se pudo descargar el reporte.");
      }

      return result;
    }



     async function exportLicensesCsv() {
      try {
        setExportStatus("Preparando reporte de licencias...");

        const result = await fetchAdminReport(`${ADMIN_LICENSES_URL}?limit=100`);
        const licenses = result.licenses || [];

        const headers = [
          "license_code",
          "license_name",
          "company_name",
          "product_name",
          "status",
          "starts_at",
          "expires_at",
          "max_users",
          "max_devices",
          "created_at",
          "updated_at"
        ];

        const rows = licenses.map((item) => ({
          license_code: item.license_id || item.license_code || "",
          license_name: item.license_name || "",
          company_name: item.company_name || "",
          product_name: item.product_name || "",
          status: item.status || "",
          starts_at: item.starts_at || "",
          expires_at: item.expires_at || "",
          max_users: item.max_users || "",
          max_devices: item.max_devices || "",
          created_at: item.created_at || "",
          updated_at: item.updated_at || ""

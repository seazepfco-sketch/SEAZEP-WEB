        licensesTableBody?.addEventListener("click", async (event) => {
      const target = event.target;

      if (!(target instanceof Element)) {
        return;
      }

      const button = target.closest("button[data-license-id]");

      if (!button) {
        return;
      }

      const commercialAction = button.dataset.commercialAction || "";
      const licenseId = button.dataset.licenseId || "";
      const nextStatus = button.dataset.nextStatus || "";

      if (commercialAction === "edit-commercial") {
        await editLicenseCommercialFromButton(button);
        return;
      }

      if (commercialAction === "renew-year") {
        await renewLicenseOneYearFromButton(button);
        return;
      }

      if (nextStatus) {
        await updateLicenseStatus(licenseId, nextStatus, button);
      }
    });



     activationsTableBody?.addEventListener("click", async (event) => {
      const target = event.target;

      if (!(target instanceof Element)) {
        return;
      }

      const button = target.closest("button[data-activation-id]");

      if (!button) {
        return;
      }

      const activationId = button.dataset.activationId || "";
      const nextStatus = button.dataset.nextActivationStatus || "";

      await updateActivationStatus(activationId, nextStatus, button);
    });



    setDefaultDates();
  </script>

          method: "GET",
          mode: "cors",
          headers: {
            "x-admin-key": adminKey
          }
        });

        const result = await response.json();

        if (!response.ok || !result.ok) {
          throw new Error(result.message || "No se pudieron cargar las licencias.");
        }

        renderLicenses(result.licenses || []);
        updateSummary(result.summary || {});

        await loadActivations();

        await loadLicenseChecks();

        await loadLicenseAudit();

        await loadCompanyLicenseReport();

        await loadLicenseAlerts();


        setStatus(
          `Licencias cargadas: ${result.count || 0} de ${result.total || 0}`,
          "success"
        );
      } catch (error) {
        renderLicenses([]);
        updateSummary({});
        setStatus(error.message || "Error al cargar licencias.", "error");
      } finally {
        if (loadLicensesButton) loadLicensesButton.disabled = false;
        if (refreshLicensesButton) refreshLicensesButton.disabled = false;
      }
    }

    async function createLicense(event) {
      event.preventDefault();

      const adminKey = getAdminKey();

      if (!adminKey) {
        setStatus("Ingrese la clave ADM antes de crear licencias.", "error");
        return;
      }

      const companyId = String(licenseCompanySelect?.value || "").trim();

      if (!companyId) {
        setStatus("Seleccione una empresa para la licencia.", "error");
        return;
      }

      setStatus("Creando licencia...");

      const payload = {
        companyId,
        productId: SMARTPOZO360_PRODUCT_ID,
        licenseName: String(licenseNameInput?.value || "").trim(),
        licenseId: String(licenseCodeInput?.value || "").trim(),
        status: String(licenseStatusInput?.value || "active"),
        startsAt: toIsoStartOfDay(String(licenseStartsAtInput?.value || "")),
        expiresAt: toIsoEndOfDay(String(licenseExpiresAtInput?.value || "")),
        maxUsers: Number(licenseMaxUsersInput?.value || 3),
        maxDevices: Number(licenseMaxDevicesInput?.value || 1),
        notes: String(licenseNotesInput?.value || "").trim()
      };

      try {
        const response = await fetch(ADMIN_LICENSES_URL, {
          method: "POST",
          mode: "cors",
          headers: {
            "x-admin-key": adminKey,
            "content-type": "text/plain;charset=UTF-8"
          },
          body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (!response.ok || !result.ok) {
          throw new Error(result.message || "No se pudo crear la licencia.");
        }

        if (licenseNameInput) licenseNameInput.value = "";
        if (licenseCodeInput) licenseCodeInput.value = "";
        if (licenseNotesInput) licenseNotesInput.value = "";

        setDefaultDates();
        setStatus(result.message || "Licencia creada correctamente.", "success");
        await loadLicenses();
      } catch (error) {
        setStatus(error.message || "Error al crear licencia.", "error");
      }
    }



     function isoToDateInput(value) {
      if (!value) return "";

      const date = new Date(value);

      if (Number.isNaN(date.getTime())) {
        return "";
      }

      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, "0");
      const day = String(date.getDate()).padStart(2, "0");

      return `${year}-${month}-${day}`;
    }

    function formatDateInputFromDate(date) {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, "0");
      const day = String(date.getDate()).padStart(2, "0");

      return `${year}-${month}-${day}`;
    }

    function addOneYearToDateInput(value) {
      const parts = String(value || "").split("-").map((part) => Number(part));

      let date;

      if (parts.length === 3 && parts.every((part) => Number.isFinite(part))) {
        date = new Date(parts[0], parts[1] - 1, parts[2]);
      } else {
        date = new Date();
      }

      if (Number.isNaN(date.getTime())) {
        date = new Date();
      }

      date.setFullYear(date.getFullYear() + 1);

      return formatDateInputFromDate(date);
    }

    function parsePromptInteger(value, fallback) {
      const number = Number(value);

      if (!Number.isFinite(number)) {
        return fallback;
      }

      const integer = Math.trunc(number);

      if (integer < 1) {
        return fallback;
      }

      return integer;
    }

    async function updateLicenseCommercial(payload, button, successMessage) {
      const adminKey = getAdminKey();

      if (!adminKey) {
        setStatus("Ingrese la clave ADM antes de actualizar datos comerciales.", "error");
        return;
      }

      if (!payload.id) {
        setStatus("Licencia no válida para actualización comercial.", "error");
        return;
      }

      if (button) {
        button.disabled = true;
      }

      setStatus("Actualizando datos comerciales de la licencia...");

      try {
        const response = await fetch(ADMIN_LICENSE_COMMERCIAL_UPDATE_URL, {
          method: "POST",
          mode: "cors",
          headers: {
            "x-admin-key": adminKey,
            "content-type": "text/plain;charset=UTF-8"
          },
          body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (!response.ok || !result.ok) {
          throw new Error(result.message || "No se pudieron actualizar los datos comerciales.");
        }

        setStatus(successMessage || result.message || "Datos comerciales actualizados correctamente.", "success");
        await loadLicenses();
      } catch (error) {
        setStatus(error.message || "Error al actualizar datos comerciales.", "error");
      } finally {
        if (button) {
          button.disabled = false;
        }
      }
    }

    async function editLicenseCommercialFromButton(button) {
      const licenseId = button.dataset.licenseId || "";
      const licenseCode = button.dataset.licenseCode || "";
      const currentName = button.dataset.licenseName || "";
      const currentStartsAt = isoToDateInput(button.dataset.startsAt || "");
      const currentExpiresAt = isoToDateInput(button.dataset.expiresAt || "");
      const currentMaxUsers = button.dataset.maxUsers || "1";
      const currentMaxDevices = button.dataset.maxDevices || "1";
      const currentNotes = button.dataset.notes || "";

      const licenseName = window.prompt(
        `Nombre comercial de la licencia ${licenseCode}:`,
        currentName
      );

      if (licenseName === null) return;

      const startsAtInput = window.prompt(
        "Fecha de inicio en formato YYYY-MM-DD:",
        currentStartsAt
      );

      if (startsAtInput === null) return;

      const expiresAtInput = window.prompt(
        "Fecha de vencimiento en formato YYYY-MM-DD:",
        currentExpiresAt
      );

      if (expiresAtInput === null) return;

      const maxUsersInput = window.prompt(
        "Máximo de usuarios permitidos:",
        currentMaxUsers
      );

      if (maxUsersInput === null) return;

      const maxDevicesInput = window.prompt(
        "Máximo de dispositivos permitidos:",
        currentMaxDevices
      );

      if (maxDevicesInput === null) return;

      const notes = window.prompt(
        "Nota comercial o administrativa del cambio:",
        currentNotes || "Actualización comercial desde panel ADM."
      );

      if (notes === null) return;

      const payload = {
        id: licenseId,
        licenseName: String(licenseName || "").trim(),
        startsAt: startsAtInput ? toIsoStartOfDay(String(startsAtInput).trim()) : "",
        expiresAt: expiresAtInput ? toIsoEndOfDay(String(expiresAtInput).trim()) : "",
        maxUsers: parsePromptInteger(maxUsersInput, Number(currentMaxUsers || 1)),
        maxDevices: parsePromptInteger(maxDevicesInput, Number(currentMaxDevices || 1)),
        notes: String(notes || "").trim()
      };

      await updateLicenseCommercial(
        payload,
        button,
        `Licencia ${licenseCode} actualizada comercialmente.`
      );
    }

    async function renewLicenseOneYearFromButton(button) {
      const licenseId = button.dataset.licenseId || "";
      const licenseCode = button.dataset.licenseCode || "";
      const currentExpiresAt = isoToDateInput(button.dataset.expiresAt || "");
      const proposedExpiresAt = addOneYearToDateInput(currentExpiresAt);

      const expiresAtInput = window.prompt(
        `Nueva fecha de vencimiento para renovar ${licenseCode} por 1 año:`,
        proposedExpiresAt
      );

      if (expiresAtInput === null) return;

      const notes = window.prompt(
        "Nota de renovación:",
        `Renovación comercial de la licencia ${licenseCode} por 1 año desde panel ADM.`
      );

      if (notes === null) return;

      const payload = {
        id: licenseId,
        expiresAt: toIsoEndOfDay(String(expiresAtInput || proposedExpiresAt).trim()),
        notes: String(notes || "").trim()
      };

      await updateLicenseCommercial(
        payload,
        button,
        `Licencia ${licenseCode} renovada correctamente.`
      );
    }




    async function updateLicenseStatus(licenseId, nextStatus, button) {
      const adminKey = getAdminKey();

      if (!adminKey) {
        setStatus("Ingrese la clave ADM antes de actualizar licencias.", "error");
        return;
      }

      if (!licenseId || !nextStatus) {
        setStatus("Licencia no válida.", "error");
        return;
      }

      const note = window.prompt(
        `Nota opcional para cambiar la licencia a ${getLicenseStatusLabel(nextStatus)}:`,
        `Cambio de estado a ${getLicenseStatusLabel(nextStatus)} desde panel ADM.`
      );

      if (note === null) {
        return;
      }

      setStatus("Actualizando licencia...");

      if (button) {
        button.disabled = true;
      }

      try {
        const response = await fetch(ADMIN_LICENSE_STATUS_URL, {
          method: "POST",
          mode: "cors",
          headers: {
            "x-admin-key": adminKey,
            "content-type": "text/plain;charset=UTF-8"
          },
          body: JSON.stringify({
            id: licenseId,
            status: nextStatus,
            note
          })
        });

        const result = await response.json();

        if (!response.ok || !result.ok) {
          throw new Error(result.message || "No se pudo actualizar la licencia.");
        }

        setStatus(result.message || "Licencia actualizada correctamente.", "success");
        await loadLicenses();
      } catch (error) {
        setStatus(error.message || "Error al actualizar licencia.", "error");
      } finally {
        if (button) {
          button.disabled = false;
        }
      }
    }


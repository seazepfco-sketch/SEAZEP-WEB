    function buildLicenseAlertsUrl() {
      const params = new URLSearchParams();
      const days = String(licenseAlertsDaysFilter?.value || "30");

      params.set("days", days);
      params.set("limit", "100");

      return `${ADMIN_LICENSE_ALERTS_URL}?${params.toString()}`;
    }

    function updateLicenseAlertsSummary(summary = {}) {
      if (alertExpiringLicenses) alertExpiringLicenses.textContent = summary.expiringLicenses || 0;
      if (alertExpiredLicenses) alertExpiredLicenses.textContent = summary.expiredLicenses || 0;
      if (alertSuspendedLicenses) alertSuspendedLicenses.textContent = summary.suspendedLicenses || 0;
      if (alertRevokedLicenses) alertRevokedLicenses.textContent = summary.revokedLicenses || 0;
      if (alertSuspendedDevices) alertSuspendedDevices.textContent = summary.suspendedDevices || 0;
      if (alertRevokedDevices) alertRevokedDevices.textContent = summary.revokedDevices || 0;
      if (alertDeviceLimitBlocks) alertDeviceLimitBlocks.textContent = summary.deviceLimitBlocks || 0;
    }

    function updateLicenseRiskCard(risk = {}) {
      const level = risk.level || "default";

      if (licenseAlertRiskCard) {
        licenseAlertRiskCard.className = `license-alert-risk-card license-alert-risk-${level}`;
      }

      if (licenseAlertRiskLabel) {
        licenseAlertRiskLabel.textContent = risk.label || "Sin riesgo";
      }

      if (licenseAlertRiskMessage) {
        licenseAlertRiskMessage.textContent = risk.message || "Sin mensaje de riesgo.";
      }
    }


    function formatAuditChange(metadata = {}) {
      const action = String(metadata.action || "");

      if (metadata.previous && metadata.next) {
        const previous = metadata.previous || {};
        const next = metadata.next || {};

        const parts = [];

        if ((previous.licenseName || "") !== (next.licenseName || "")) {
          parts.push(`Nombre: ${previous.licenseName || "N/D"} → ${next.licenseName || "N/D"}`);
        }

        if ((previous.startsAt || "") !== (next.startsAt || "")) {
          parts.push(`Inicio: ${formatDate(previous.startsAt)} → ${formatDate(next.startsAt)}`);
        }

        if ((previous.expiresAt || "") !== (next.expiresAt || "")) {
          parts.push(`Vencimiento: ${formatDate(previous.expiresAt)} → ${formatDate(next.expiresAt)}`);
        }

        if (String(previous.maxUsers || "") !== String(next.maxUsers || "")) {
          parts.push(`Usuarios: ${previous.maxUsers || "N/D"} → ${next.maxUsers || "N/D"}`);
        }

        if (String(previous.maxDevices || "") !== String(next.maxDevices || "")) {
          parts.push(`Dispositivos: ${previous.maxDevices || "N/D"} → ${next.maxDevices || "N/D"}`);
        }

        if (!parts.length) {
          parts.push("Cambio comercial registrado sin diferencias principales visibles.");
        }

        return parts.join(" | ");
      }

      if (metadata.previousStatus || metadata.newStatus) {
        return `Estado: ${getLicenseStatusLabel(metadata.previousStatus)} → ${getLicenseStatusLabel(metadata.newStatus)}`;
      }

      if (metadata.machineId && metadata.maxDevices) {
        return `Equipo ${metadata.machineId}. Activaciones: ${metadata.activeActivations || "N/D"} / ${metadata.maxDevices}.`;
      }

      if (metadata.licenseId || metadata.licenseCode) {
        return `Licencia ${metadata.licenseId || metadata.licenseCode}.`;
      }

      return JSON.stringify(metadata).slice(0, 240);
    }


---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionTitle from "../../components/SectionTitle.astro";
---

<BaseLayout title="Licencias ADM | SEAZEP">
  <Header active="admin" />

  <main>
    <section class="section">
      <SectionTitle
        eyebrow="ADM SEAZEP"
        title="Licencias SmartPozo360."
        text="Administre licencias por empresa, vigencia, estado, usuarios permitidos y dispositivos autorizados."
      />

      <div class="admin-access-panel">
        <div>
          <h3>Acceso temporal ADM</h3>
          <p>
            Ingrese la clave administrativa para consultar y administrar licencias.
          </p>
        </div>

        <div class="admin-key-form">
          <input
            class="input"
            id="adminApiKey"
            type="password"
            placeholder="Clave ADM temporal"
            autocomplete="off"
          />

          <button class="btn btn-primary" id="loadLicensesButton" type="button">
            Cargar licencias
          </button>

          <a class="btn btn-ghost" href="/admin/empresas">
            Empresas
          </a>

          <a class="btn btn-ghost" href="/admin/usuarios">
            Usuarios
          </a>

          <a class="btn btn-ghost" href="/admin/manuales">
            Manuales
          </a>
        </div>

        <p id="adminLicensesStatus" class="form-status" aria-live="polite"></p>
      </div>

      <section class="admin-filter-panel license-create-panel">
        <div class="admin-filter-header">
          <div>
            <span class="eyebrow">Nueva licencia</span>
            <h3>Crear licencia SmartPozo360</h3>
          </div>
        </div>

        <form class="license-form-grid" id="createLicenseForm">
          <label class="admin-filter-field">
            <span>Empresa</span>
            <select class="input" id="licenseCompanySelect" required>
              <option value="">Cargue empresas con la clave ADM</option>
            </select>
          </label>

          <label class="admin-filter-field">
            <span>Software</span>
            <input
              class="input"
              value="SmartPozo360"
              disabled
            />
          </label>

          <label class="admin-filter-field">
            <span>Nombre de licencia</span>
            <input
              class="input"
              id="licenseNameInput"
              placeholder="Licencia SmartPozo360 anual"
            />
          </label>

          <label class="admin-filter-field">
            <span>ID de licencia</span>
            <input
              class="input"
              id="licenseCodeInput"
              placeholder="Automático si se deja vacío"
            />
          </label>

          <label class="admin-filter-field">
            <span>Estado</span>
            <select class="input" id="licenseStatusInput">
              <option value="active">Activa</option>
              <option value="suspended">Suspendida</option>
              <option value="expired">Expirada</option>
              <option value="revoked">Revocada</option>
            </select>
          </label>

          <label class="admin-filter-field">
            <span>Máx. usuarios</span>
            <input
              class="input"
              id="licenseMaxUsersInput"
              type="number"
              min="1"
              value="3"
            />
          </label>

          <label class="admin-filter-field">
            <span>Máx. dispositivos</span>
            <input
              class="input"
              id="licenseMaxDevicesInput"
              type="number"
              min="1"
              value="1"
            />
          </label>

          <label class="admin-filter-field">
            <span>Inicio</span>
            <input
              class="input"
              id="licenseStartsAtInput"
              type="date"
            />
          </label>

          <label class="admin-filter-field">
            <span>Vencimiento</span>
            <input
              class="input"
              id="licenseExpiresAtInput"
              type="date"
            />
          </label>

          <label class="admin-filter-field license-notes-field">
            <span>Notas</span>
            <textarea
              class="input"
              id="licenseNotesInput"
              placeholder="Observaciones internas de la licencia"
            ></textarea>
          </label>

          <button class="btn btn-primary" type="submit">
            Crear licencia
          </button>
        </form>
      </section>

      <section class="admin-filter-panel">
        <div class="admin-filter-header">
          <div>
            <span class="eyebrow">Filtros ADM</span>
            <h3>Consulta de licencias</h3>
          </div>

          <button class="btn btn-secondary" type="button" id="clearLicenseFiltersButton">
            Limpiar filtros
          </button>
        </div>

        <div class="admin-filter-grid">
          <label class="admin-filter-field">
            <span>Estado</span>
            <select class="input" id="licenseStatusFilter">
              <option value="all">Todos</option>
              <option value="active">Activas</option>
              <option value="suspended">Suspendidas</option>
              <option value="expired">Expiradas</option>
              <option value="revoked">Revocadas</option>
            </select>
          </label>

          <label class="admin-filter-field">
            <span>Empresa</span>
            <select class="input" id="licenseCompanyFilter">
              <option value="all">Todas</option>
            </select>
          </label>

          <label class="admin-filter-field admin-filter-search">
            <span>Buscar</span>
            <input
              class="input"
              id="licenseSearchInput"
              placeholder="Licencia, empresa, correo, software o nota"
            />
          </label>
        </div>

        <div class="admin-summary-grid licenses-summary-grid">
          <article class="admin-summary-card">
            <span>Total</span>
            <strong id="summaryTotalLicenses">0</strong>
          </article>

          <article class="admin-summary-card">
            <span>Activas</span>
            <strong id="summaryActiveLicenses">0</strong>
          </article>

          <article class="admin-summary-card">
            <span>Suspendidas</span>
            <strong id="summarySuspendedLicenses">0</strong>
          </article>

          <article class="admin-summary-card">
            <span>Expiradas</span>
            <strong id="summaryExpiredLicenses">0</strong>
          </article>

          <article class="admin-summary-card">
            <span>Revocadas</span>
            <strong id="summaryRevokedLicenses">0</strong>
          </article>
        </div>
      </section>



       <section class="admin-filter-panel license-export-panel">
        <div class="admin-filter-header">
          <div>
            <span class="eyebrow">Reportes ADM</span>
            <h3>Exportar información de licencias</h3>
            <p>
              Descargue reportes CSV para control comercial, técnico y administrativo de SmartPozo360.
            </p>
          </div>
        </div>

        <div class="license-export-actions">
          <button class="btn btn-ghost" id="exportLicensesButton" type="button">
            Descargar licencias CSV
          </button>

          <button class="btn btn-ghost" id="exportActivationsButton" type="button">
            Descargar activaciones CSV
          </button>

          <button class="btn btn-ghost" id="exportChecksButton" type="button">
            Descargar historial CSV
          </button>
        </div>

        <p id="licenseExportStatus" class="form-status" aria-live="polite"></p>
      </section>



          <section class="admin-requests-section license-final-alerts-section">
        <div class="admin-section-header">
          <div>
            <span class="eyebrow">Alertas finales</span>
            <h2>Alertas comerciales y técnicas de licencias.</h2>
            <p>
              Resumen final para detectar vencimientos, suspensiones, revocaciones y bloqueos por límite de dispositivos.
            </p>
          </div>

          <div class="admin-action-buttons">
            <button class="btn btn-ghost" id="refreshLicenseAlertsButton" type="button">
              Actualizar alertas
            </button>

            <button class="btn btn-primary" id="sendLicenseAlertsEmailButton" type="button">
              Enviar alerta por correo
            </button>
          </div>
        </div>

        <div class="admin-filter-panel">
          <div class="admin-filter-grid">
            <label class="admin-filter-field">
              <span>Ventana de vencimiento</span>
              <select class="input" id="licenseAlertsDaysFilter">
                <option value="7">Próximos 7 días</option>
                <option value="15">Próximos 15 días</option>
                <option value="30" selected>Próximos 30 días</option>
                <option value="60">Próximos 60 días</option>
                <option value="90">Próximos 90 días</option>
              </select>
            </label>

            <label class="admin-filter-field admin-filter-search">
              <span>Correo destino</span>
              <input
                class="input"
                id="licenseAlertsEmailInput"
                placeholder="correo@seazep.com"
              />
            </label>
          </div>
        </div>

        <div class="license-alert-risk-card" id="licenseAlertRiskCard">
          <span class="eyebrow">Riesgo general</span>
          <h3 id="licenseAlertRiskLabel">Sin cargar</h3>
          <p id="licenseAlertRiskMessage">
            Cargue las licencias para consultar el estado final de alertas.
          </p>
        </div>

        <div class="licenses-summary-grid license-alerts-summary-grid">
          <article>
            <span>Por vencer</span>
            <strong id="alertExpiringLicenses">0</strong>
          </article>

          <article>
            <span>Vencidas</span>
            <strong id="alertExpiredLicenses">0</strong>
          </article>

          <article>
            <span>Lic. suspendidas</span>
            <strong id="alertSuspendedLicenses">0</strong>
          </article>

          <article>
            <span>Lic. revocadas</span>
            <strong id="alertRevokedLicenses">0</strong>
          </article>

          <article>
            <span>Equipos suspendidos</span>
            <strong id="alertSuspendedDevices">0</strong>
          </article>

          <article>
            <span>Equipos revocados</span>
            <strong id="alertRevokedDevices">0</strong>
          </article>

          <article>
            <span>Bloqueos límite</span>
            <strong id="alertDeviceLimitBlocks">0</strong>
          </article>
        </div>

        <div class="license-alert-lists-grid">
          <article class="license-alert-list-card">
            <h3>Licencias por vencer</h3>
            <div id="expiringLicensesList" class="license-alert-list">
              <p class="admin-empty">Sin datos cargados.</p>
            </div>
          </article>

          <article class="license-alert-list-card">
            <h3>Licencias vencidas</h3>
            <div id="expiredLicensesList" class="license-alert-list">
              <p class="admin-empty">Sin datos cargados.</p>
            </div>
          </article>

          <article class="license-alert-list-card">
            <h3>Equipos con alerta</h3>
            <div id="deviceAlertsList" class="license-alert-list">
              <p class="admin-empty">Sin datos cargados.</p>
            </div>
          </article>

          <article class="license-alert-list-card">
            <h3>Bloqueos por límite</h3>
            <div id="deviceLimitBlocksList" class="license-alert-list">
              <p class="admin-empty">Sin datos cargados.</p>
            </div>
          </article>
        </div>

        <p id="licenseAlertsStatus" class="form-status" aria-live="polite"></p>
      </section>




         <section class="admin-requests-section company-license-report-section">
        <div class="admin-section-header">
          <div>
            <span class="eyebrow">Reporte ejecutivo</span>
            <h2>Licencias por empresa.</h2>
            <p>
              Vista consolidada para seguimiento comercial y técnico por cliente.
            </p>
          </div>

          <button class="btn btn-ghost" id="refreshCompanyReportButton" type="button">
            Actualizar reporte
          </button>
        </div>

        <div class="admin-filter-panel">
          <div class="admin-filter-grid">
            <label class="admin-filter-field">
              <span>Nivel de riesgo</span>
              <select class="input" id="companyRiskFilter">
                <option value="all">Todos</option>
                <option value="critical">Crítico</option>
                <option value="warning">Atención</option>
                <option value="ok">Correcto</option>
              </select>
            </label>

            <label class="admin-filter-field admin-filter-search">
              <span>Buscar empresa</span>
              <input
                class="input"
                id="companyReportSearchInput"
                placeholder="Empresa, licencia, software o estado"
              />
            </label>
          </div>
        </div>

        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Empresa</th>
                <th>Licencias</th>
                <th>Equipos</th>
                <th>Último check</th>
                <th>Riesgo</th>
                <th>Resumen ejecutivo</th>
              </tr>
            </thead>

            <tbody id="companyReportTableBody">
              <tr>
                <td colspan="6" class="admin-empty">
                  Cargue las licencias para ver el reporte ejecutivo por empresa.
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <p id="companyReportStatus" class="form-status" aria-live="polite"></p>
      </section>



      <section class="admin-requests-section">
        <div class="admin-section-header">
          <div>
            <span class="eyebrow">Registros</span>
            <h2>Licencias registradas.</h2>
          </div>

          <button class="btn btn-ghost" id="refreshLicensesButton" type="button">
            Actualizar
          </button>
        </div>

        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Licencia</th>
                <th>Empresa</th>
                <th>Software</th>
                <th>Estado</th>
                <th>Vigencia</th>
                <th>Límites</th>
                <th>Acciones</th>
              </tr>
            </thead>

            <tbody id="licensesTableBody">
              <tr>
                <td colspan="7" class="admin-empty">
                  Ingrese la clave ADM y presione “Cargar licencias”.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>


     <section class="admin-requests-section license-activations-section">
        <div class="admin-section-header">
          <div>
            <span class="eyebrow">Equipos autorizados</span>
            <h2>Activaciones por licencia.</h2>
            <p>
              Consulte los equipos activados, versión de la aplicación y último check registrado.
            </p>
          </div>

          <button class="btn btn-ghost" id="refreshActivationsButton" type="button">
            Actualizar activaciones
          </button>
        </div>

        <div class="admin-filter-panel">
          <div class="admin-filter-grid">
            <label class="admin-filter-field">
              <span>Estado de activación</span>
              <select class="input" id="activationStatusFilter">
                <option value="all">Todos</option>
                <option value="active">Activas</option>
                <option value="suspended">Suspendidas</option>
                <option value="expired">Expiradas</option>
                <option value="revoked">Revocadas</option>
              </select>
            </label>

            <label class="admin-filter-field admin-filter-search">
              <span>Buscar equipo</span>
              <input
                class="input"
                id="activationSearchInput"
                placeholder="Machine ID, licencia, empresa, software o versión"
              />
            </label>
          </div>
        </div>

        <div class="admin-table-wrap">
          <table class="admin-table">
             <thead>
              <tr>
                <th>Equipo</th>
                <th>Licencia</th>
                <th>Empresa</th>
                <th>Software</th>
                <th>Estado</th>
                <th>Fechas</th>
                <th>Acciones</th>
              </tr>
            </thead>

             <tbody id="activationsTableBody">
              <tr>
                <td colspan="7" class="admin-empty">
                  Cargue las licencias para ver equipos activados.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

    <section class="admin-requests-section license-checks-section">
        <div class="admin-section-header">
          <div>
            <span class="eyebrow">Historial técnico</span>
            <h2>Historial de validaciones.</h2>
            <p>
              Consulte eventos de validación, activación, bloqueo por límite, suspensión y otros resultados generados por SmartPozo360.
            </p>
          </div>

          <button class="btn btn-ghost" id="refreshChecksButton" type="button">
            Actualizar historial
          </button>
        </div>

        <div class="admin-filter-panel">
          <div class="admin-filter-grid">
            <label class="admin-filter-field">
              <span>Tipo de evento</span>
              <select class="input" id="checkTypeFilter">
                <option value="all">Todos</option>
                <option value="license_check">Validación de licencia</option>
                <option value="activation_register">Registro de activación</option>
                <option value="admin_activation_status_update">Cambio ADM de equipo</option>
              </select>
            </label>

            <label class="admin-filter-field">
              <span>Resultado</span>
              <select class="input" id="checkResultFilter">
                <option value="all">Todos</option>
                <option value="valid">Válida</option>
                <option value="requires_activation">Requiere activación</option>
                <option value="activation_success">Activación exitosa</option>
                <option value="already_activated">Ya activado</option>
                <option value="device_limit_reached">Límite de dispositivos</option>
                <option value="device_suspended">Equipo suspendido</option>
                <option value="device_revoked">Equipo revocado</option>
                <option value="suspended">Suspendido ADM</option>
                <option value="active">Activado ADM</option>
                <option value="revoked">Revocado ADM</option>
                <option value="not_found">No encontrado</option>
              </select>
            </label>

            <label class="admin-filter-field admin-filter-search">
              <span>Buscar historial</span>
              <input
                class="input"
                id="checkSearchInput"
                placeholder="Licencia, equipo, empresa, IP, resultado o navegador"
              />
            </label>
          </div>
        </div>

        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Licencia</th>
                <th>Equipo</th>
                <th>Evento</th>
                <th>Resultado</th>
                <th>Empresa / Software</th>
                <th>Origen</th>
              </tr>
            </thead>

            <tbody id="checksTableBody">
              <tr>
                <td colspan="7" class="admin-empty">
                  Cargue las licencias para ver el historial de validaciones.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>


        <section class="admin-requests-section license-audit-section">
        <div class="admin-section-header">
          <div>
            <span class="eyebrow">Auditoría ADM</span>
            <h2>Historial de cambios de licencias.</h2>
            <p>
              Consulte movimientos administrativos sobre licencias, renovaciones, límites, estados y activaciones de equipos.
            </p>
          </div>

          <button class="btn btn-ghost" id="refreshAuditButton" type="button">
            Actualizar auditoría
          </button>
        </div>

        <div class="admin-filter-panel">
          <div class="admin-filter-grid">
            <label class="admin-filter-field">
              <span>Acción</span>
              <select class="input" id="auditActionFilter">
                <option value="all">Todas</option>
                <option value="admin_license_created">Licencia creada</option>
                <option value="admin_license_status_updated">Cambio de estado de licencia</option>
                <option value="admin_license_commercial_updated">Cambio comercial / renovación</option>
                <option value="admin_license_activation_status_updated">Cambio de estado de equipo</option>
                <option value="license_device_activated">Equipo activado</option>
              </select>
            </label>

            <label class="admin-filter-field admin-filter-search">
              <span>Buscar auditoría</span>
              <input
                class="input"
                id="auditSearchInput"
                placeholder="Licencia, empresa, equipo, acción o dato comercial"
              />
            </label>
          </div>
        </div>

        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Acción</th>
                <th>Entidad</th>
                <th>Licencia / Empresa</th>
                <th>Detalle del cambio</th>
                <th>Actor</th>
              </tr>
            </thead>

            <tbody id="auditTableBody">
              <tr>
                <td colspan="6" class="admin-empty">
                  Cargue las licencias para ver auditoría administrativa.
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <p id="licenseAuditStatus" class="form-status" aria-live="polite"></p>
      </section>



    </section>
  </main>

  <Footer />

  <script>
    const ADMIN_LICENSES_URL = "https://seazep-api.seazepfco.workers.dev/admin/licenses";
    const ADMIN_LICENSE_STATUS_URL = "https://seazep-api.seazepfco.workers.dev/admin/licenses/update-status";
    const ADMIN_LICENSE_COMMERCIAL_UPDATE_URL = "https://seazep-api.seazepfco.workers.dev/admin/licenses/update-commercial";
    const ADMIN_COMPANIES_URL = "https://seazep-api.seazepfco.workers.dev/admin/companies";
    const ADMIN_LICENSE_ACTIVATIONS_URL = "https://seazep-api.seazepfco.workers.dev/admin/license-activations";
    const ADMIN_LICENSE_ACTIVATIONS_UPDATE_STATUS_URL = "https://seazep-api.seazepfco.workers.dev/admin/license-activations/update-status";
    const ADMIN_LICENSE_CHECKS_URL = "https://seazep-api.seazepfco.workers.dev/admin/license-checks";
    const ADMIN_LICENSE_AUDIT_URL = "https://seazep-api.seazepfco.workers.dev/admin/license-audit";
    const ADMIN_LICENSE_ALERTS_URL = "https://seazep-api.seazepfco.workers.dev/admin/license-alerts";
    const ADMIN_LICENSE_ALERTS_SEND_URL = "https://seazep-api.seazepfco.workers.dev/admin/license-alerts/send";
    const SMARTPOZO360_PRODUCT_ID = "spz-product-smartpozo360";

    const adminKeyInput = document.getElementById("adminApiKey");
    const loadLicensesButton = document.getElementById("loadLicensesButton");
    const refreshLicensesButton = document.getElementById("refreshLicensesButton");
    const clearLicenseFiltersButton = document.getElementById("clearLicenseFiltersButton");
    const statusEl = document.getElementById("adminLicensesStatus");

    const createLicenseForm = document.getElementById("createLicenseForm");
    const licenseCompanySelect = document.getElementById("licenseCompanySelect");
    const licenseCompanyFilter = document.getElementById("licenseCompanyFilter");
    const licenseNameInput = document.getElementById("licenseNameInput");
    const licenseCodeInput = document.getElementById("licenseCodeInput");
    const licenseStatusInput = document.getElementById("licenseStatusInput");
    const licenseMaxUsersInput = document.getElementById("licenseMaxUsersInput");
    const licenseMaxDevicesInput = document.getElementById("licenseMaxDevicesInput");
    const licenseStartsAtInput = document.getElementById("licenseStartsAtInput");
    const licenseExpiresAtInput = document.getElementById("licenseExpiresAtInput");
    const licenseNotesInput = document.getElementById("licenseNotesInput");

    const licenseStatusFilter = document.getElementById("licenseStatusFilter");
    const licenseSearchInput = document.getElementById("licenseSearchInput");
    const licensesTableBody = document.getElementById("licensesTableBody");

    const activationsTableBody = document.getElementById("activationsTableBody");
    const refreshActivationsButton = document.getElementById("refreshActivationsButton");
    const activationStatusFilter = document.getElementById("activationStatusFilter");
    const activationSearchInput = document.getElementById("activationSearchInput");

     const checksTableBody = document.getElementById("checksTableBody");
    const refreshChecksButton = document.getElementById("refreshChecksButton");
    const checkTypeFilter = document.getElementById("checkTypeFilter");
    const checkResultFilter = document.getElementById("checkResultFilter");
    const checkSearchInput = document.getElementById("checkSearchInput");

    const auditTableBody = document.getElementById("auditTableBody");
    const refreshAuditButton = document.getElementById("refreshAuditButton");
    const auditActionFilter = document.getElementById("auditActionFilter");
    const auditSearchInput = document.getElementById("auditSearchInput");
    const licenseAuditStatus = document.getElementById("licenseAuditStatus");

    const exportLicensesButton = document.getElementById("exportLicensesButton");
    const exportActivationsButton = document.getElementById("exportActivationsButton");
    const exportChecksButton = document.getElementById("exportChecksButton");
    const licenseExportStatus = document.getElementById("licenseExportStatus");


    const summaryTotalLicenses = document.getElementById("summaryTotalLicenses");
    const summaryActiveLicenses = document.getElementById("summaryActiveLicenses");
    const summarySuspendedLicenses = document.getElementById("summarySuspendedLicenses");
    const summaryExpiredLicenses = document.getElementById("summaryExpiredLicenses");
    const summaryRevokedLicenses = document.getElementById("summaryRevokedLicenses");

    const companyReportTableBody = document.getElementById("companyReportTableBody");
    const refreshCompanyReportButton = document.getElementById("refreshCompanyReportButton");
    const companyRiskFilter = document.getElementById("companyRiskFilter");
    const companyReportSearchInput = document.getElementById("companyReportSearchInput");

    function renderLicenseAlerts(data = {}) {
      const summary = data.summary || {};
      const risk = data.risk || {};
      const alerts = data.alerts || {};

      updateLicenseAlertsSummary(summary);
      updateLicenseRiskCard(risk);

      renderLicenseAlertItems(expiringLicensesList, alerts.expiringLicenses || [], "license");
      renderLicenseAlertItems(expiredLicensesList, alerts.expiredLicenses || [], "license");

      renderLicenseAlertItems(deviceAlertsList, [
        ...(alerts.suspendedDevices || []),
        ...(alerts.revokedDevices || []),
        ...(alerts.expiredDevices || [])
      ], "device");


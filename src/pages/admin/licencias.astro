---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionTitle from "../../components/SectionTitle.astro";
---

<BaseLayout title="Licencias ADM | SEAZEP">
  <Header active="admin" />

  <main>
    <section class="section">
      <SectionTitle
        eyebrow="ADM SEAZEP"
        title="Licencias SmartPozo360."
        text="Administre licencias por empresa, vigencia, estado, usuarios permitidos y dispositivos autorizados."
      />

      <div class="admin-access-panel">
        <div>
          <h3>Acceso temporal ADM</h3>
          <p>
            Ingrese la clave administrativa para consultar y administrar licencias.
          </p>
        </div>

        <div class="admin-key-form">
          <input
            class="input"
            id="adminApiKey"
            type="password"
            placeholder="Clave ADM temporal"
            autocomplete="off"
          />

          <button class="btn btn-primary" id="loadLicensesButton" type="button">
            Cargar licencias
          </button>

          <a class="btn btn-ghost" href="/admin/empresas">
            Empresas
          </a>

          <a class="btn btn-ghost" href="/admin/usuarios">
            Usuarios
          </a>

          <a class="btn btn-ghost" href="/admin/manuales">
            Manuales
          </a>
        </div>

        <p id="adminLicensesStatus" class="form-status" aria-live="polite"></p>
      </div>

      <section class="admin-filter-panel license-create-panel">
        <div class="admin-filter-header">
          <div>
            <span class="eyebrow">Nueva licencia</span>
            <h3>Crear licencia SmartPozo360</h3>
          </div>
        </div>

        <form class="license-form-grid" id="createLicenseForm">
          <label class="admin-filter-field">
            <span>Empresa</span>
            <select class="input" id="licenseCompanySelect" required>
              <option value="">Cargue empresas con la clave ADM</option>
            </select>
          </label>

          <label class="admin-filter-field">
            <span>Software</span>
            <input
              class="input"
              value="SmartPozo360"
              disabled
            />
          </label>

          <label class="admin-filter-field">
            <span>Nombre de licencia</span>
            <input
              class="input"
              id="licenseNameInput"
              placeholder="Licencia SmartPozo360 anual"
            />
          </label>

          <label class="admin-filter-field">
            <span>ID de licencia</span>
            <input
              class="input"
              id="licenseCodeInput"
              placeholder="Automático si se deja vacío"
            />
          </label>

          <label class="admin-filter-field">
            <span>Estado</span>
            <select class="input" id="licenseStatusInput">
              <option value="active">Activa</option>
              <option value="suspended">Suspendida</option>
              <option value="expired">Expirada</option>
              <option value="revoked">Revocada</option>
            </select>
          </label>

          <label class="admin-filter-field">
            <span>Máx. usuarios</span>
            <input
              class="input"
              id="licenseMaxUsersInput"
              type="number"
              min="1"
              value="3"
            />
          </label>

          <label class="admin-filter-field">
            <span>Máx. dispositivos</span>
            <input
              class="input"
              id="licenseMaxDevicesInput"
              type="number"
              min="1"
              value="1"
            />
          </label>

          <label class="admin-filter-field">
            <span>Inicio</span>
            <input
              class="input"
              id="licenseStartsAtInput"
              type="date"
            />
          </label>

          <label class="admin-filter-field">
            <span>Vencimiento</span>
            <input
              class="input"
              id="licenseExpiresAtInput"
              type="date"
            />
          </label>

          <label class="admin-filter-field license-notes-field">
            <span>Notas</span>
            <textarea
              class="input"
              id="licenseNotesInput"
              placeholder="Observaciones internas de la licencia"
            ></textarea>
          </label>

          <button class="btn btn-primary" type="submit">
            Crear licencia
          </button>
        </form>
      </section>

      <section class="admin-filter-panel">
        <div class="admin-filter-header">
          <div>
            <span class="eyebrow">Filtros ADM</span>
            <h3>Consulta de licencias</h3>
          </div>

          <button class="btn btn-secondary" type="button" id="clearLicenseFiltersButton">
            Limpiar filtros
          </button>
        </div>

        <div class="admin-filter-grid">
          <label class="admin-filter-field">
            <span>Estado</span>
            <select class="input" id="licenseStatusFilter">
              <option value="all">Todos</option>
              <option value="active">Activas</option>
              <option value="suspended">Suspendidas</option>
              <option value="expired">Expiradas</option>
              <option value="revoked">Revocadas</option>
            </select>
          </label>

          <label class="admin-filter-field">
            <span>Empresa</span>
            <select class="input" id="licenseCompanyFilter">
              <option value="all">Todas</option>
            </select>
          </label>

          <label class="admin-filter-field admin-filter-search">
            <span>Buscar</span>
            <input
              class="input"
              id="licenseSearchInput"
              placeholder="Licencia, empresa, correo, software o nota"
            />
          </label>
        </div>

        <div class="admin-summary-grid licenses-summary-grid">
          <article class="admin-summary-card">
            <span>Total</span>
            <strong id="summaryTotalLicenses">0</strong>
          </article>

          <article class="admin-summary-card">
            <span>Activas</span>
            <strong id="summaryActiveLicenses">0</strong>
          </article>

          <article class="admin-summary-card">
            <span>Suspendidas</span>
            <strong id="summarySuspendedLicenses">0</strong>
          </article>

          <article class="admin-summary-card">
            <span>Expiradas</span>
            <strong id="summaryExpiredLicenses">0</strong>
          </article>

          <article class="admin-summary-card">
            <span>Revocadas</span>
            <strong id="summaryRevokedLicenses">0</strong>
          </article>
        </div>
      </section>

      <section class="admin-requests-section">
        <div class="admin-section-header">
          <div>
            <span class="eyebrow">Registros</span>
            <h2>Licencias registradas.</h2>
          </div>

          <button class="btn btn-ghost" id="refreshLicensesButton" type="button">
            Actualizar
          </button>
        </div>

        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Licencia</th>
                <th>Empresa</th>
                <th>Software</th>
                <th>Estado</th>
                <th>Vigencia</th>
                <th>Límites</th>
                <th>Acciones</th>
              </tr>
            </thead>

            <tbody id="licensesTableBody">
              <tr>
                <td colspan="7" class="admin-empty">
                  Ingrese la clave ADM y presione “Cargar licencias”.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>


     <section class="admin-requests-section license-activations-section">
        <div class="admin-section-header">
          <div>
            <span class="eyebrow">Equipos autorizados</span>
            <h2>Activaciones por licencia.</h2>
            <p>
              Consulte los equipos activados, versión de la aplicación y último check registrado.
            </p>
          </div>

          <button class="btn btn-ghost" id="refreshActivationsButton" type="button">
            Actualizar activaciones
          </button>
        </div>

        <div class="admin-filter-panel">
          <div class="admin-filter-grid">
            <label class="admin-filter-field">
              <span>Estado de activación</span>
              <select class="input" id="activationStatusFilter">
                <option value="all">Todos</option>
                <option value="active">Activas</option>
                <option value="suspended">Suspendidas</option>
                <option value="expired">Expiradas</option>
                <option value="revoked">Revocadas</option>
              </select>
            </label>

            <label class="admin-filter-field admin-filter-search">
              <span>Buscar equipo</span>
              <input
                class="input"
                id="activationSearchInput"
                placeholder="Machine ID, licencia, empresa, software o versión"
              />
            </label>
          </div>
        </div>

        <div class="admin-table-wrap">
          <table class="admin-table">
             <thead>
              <tr>
                <th>Equipo</th>
                <th>Licencia</th>
                <th>Empresa</th>
                <th>Software</th>
                <th>Estado</th>
                <th>Fechas</th>
                <th>Acciones</th>
              </tr>
            </thead>

             <tbody id="activationsTableBody">
              <tr>
                <td colspan="7" class="admin-empty">
                  Cargue las licencias para ver equipos activados.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

    <section class="admin-requests-section license-checks-section">
        <div class="admin-section-header">
          <div>
            <span class="eyebrow">Historial técnico</span>
            <h2>Historial de validaciones.</h2>
            <p>
              Consulte eventos de validación, activación, bloqueo por límite, suspensión y otros resultados generados por SmartPozo360.
            </p>
          </div>

          <button class="btn btn-ghost" id="refreshChecksButton" type="button">
            Actualizar historial
          </button>
        </div>

        <div class="admin-filter-panel">
          <div class="admin-filter-grid">
            <label class="admin-filter-field">
              <span>Tipo de evento</span>
              <select class="input" id="checkTypeFilter">
                <option value="all">Todos</option>
                <option value="license_check">Validación de licencia</option>
                <option value="activation_register">Registro de activación</option>
                <option value="admin_activation_status_update">Cambio ADM de equipo</option>
              </select>
            </label>

            <label class="admin-filter-field">
              <span>Resultado</span>
              <select class="input" id="checkResultFilter">
                <option value="all">Todos</option>
                <option value="valid">Válida</option>
                <option value="requires_activation">Requiere activación</option>
                <option value="activation_success">Activación exitosa</option>
                <option value="already_activated">Ya activado</option>
                <option value="device_limit_reached">Límite de dispositivos</option>
                <option value="device_suspended">Equipo suspendido</option>
                <option value="device_revoked">Equipo revocado</option>
                <option value="suspended">Suspendido ADM</option>
                <option value="active">Activado ADM</option>
                <option value="revoked">Revocado ADM</option>
                <option value="not_found">No encontrado</option>
              </select>
            </label>

            <label class="admin-filter-field admin-filter-search">
              <span>Buscar historial</span>
              <input
                class="input"
                id="checkSearchInput"
                placeholder="Licencia, equipo, empresa, IP, resultado o navegador"
              />
            </label>
          </div>
        </div>

        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Licencia</th>
                <th>Equipo</th>
                <th>Evento</th>
                <th>Resultado</th>
                <th>Empresa / Software</th>
                <th>Origen</th>
              </tr>
            </thead>

            <tbody id="checksTableBody">
              <tr>
                <td colspan="7" class="admin-empty">
                  Cargue las licencias para ver el historial de validaciones.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

    </section>
  </main>

  <Footer />

  <script>
    const ADMIN_LICENSES_URL = "https://seazep-api.seazepfco.workers.dev/admin/licenses";
    const ADMIN_LICENSE_STATUS_URL = "https://seazep-api.seazepfco.workers.dev/admin/licenses/update-status";
    const ADMIN_COMPANIES_URL = "https://seazep-api.seazepfco.workers.dev/admin/companies";
    const ADMIN_LICENSE_ACTIVATIONS_URL = "https://seazep-api.seazepfco.workers.dev/admin/license-activations";
    const ADMIN_LICENSE_ACTIVATIONS_UPDATE_STATUS_URL = "https://seazep-api.seazepfco.workers.dev/admin/license-activations/update-status";
    const ADMIN_LICENSE_CHECKS_URL = "https://seazep-api.seazepfco.workers.dev/admin/license-checks";
    const SMARTPOZO360_PRODUCT_ID = "spz-product-smartpozo360";

    const adminKeyInput = document.getElementById("adminApiKey");
    const loadLicensesButton = document.getElementById("loadLicensesButton");
    const refreshLicensesButton = document.getElementById("refreshLicensesButton");
    const clearLicenseFiltersButton = document.getElementById("clearLicenseFiltersButton");
    const statusEl = document.getElementById("adminLicensesStatus");

    const createLicenseForm = document.getElementById("createLicenseForm");
    const licenseCompanySelect = document.getElementById("licenseCompanySelect");
    const licenseCompanyFilter = document.getElementById("licenseCompanyFilter");
    const licenseNameInput = document.getElementById("licenseNameInput");
    const licenseCodeInput = document.getElementById("licenseCodeInput");
    const licenseStatusInput = document.getElementById("licenseStatusInput");
    const licenseMaxUsersInput = document.getElementById("licenseMaxUsersInput");
    const licenseMaxDevicesInput = document.getElementById("licenseMaxDevicesInput");
    const licenseStartsAtInput = document.getElementById("licenseStartsAtInput");
    const licenseExpiresAtInput = document.getElementById("licenseExpiresAtInput");
    const licenseNotesInput = document.getElementById("licenseNotesInput");

    const licenseStatusFilter = document.getElementById("licenseStatusFilter");
    const licenseSearchInput = document.getElementById("licenseSearchInput");
    const licensesTableBody = document.getElementById("licensesTableBody");

    const activationsTableBody = document.getElementById("activationsTableBody");
    const refreshActivationsButton = document.getElementById("refreshActivationsButton");
    const activationStatusFilter = document.getElementById("activationStatusFilter");
    const activationSearchInput = document.getElementById("activationSearchInput");

     const checksTableBody = document.getElementById("checksTableBody");
    const refreshChecksButton = document.getElementById("refreshChecksButton");
    const checkTypeFilter = document.getElementById("checkTypeFilter");
    const checkResultFilter = document.getElementById("checkResultFilter");
    const checkSearchInput = document.getElementById("checkSearchInput");

    const summaryTotalLicenses = document.getElementById("summaryTotalLicenses");
    const summaryActiveLicenses = document.getElementById("summaryActiveLicenses");
    const summarySuspendedLicenses = document.getElementById("summarySuspendedLicenses");
    const summaryExpiredLicenses = document.getElementById("summaryExpiredLicenses");
    const summaryRevokedLicenses = document.getElementById("summaryRevokedLicenses");

    function getAdminKey() {
      return String(adminKeyInput?.value || "").trim();
    }

    function setStatus(message, type = "") {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.className = type ? `form-status ${type}` : "form-status";
    }

    function escapeHtml(value) {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function getLicenseStatusLabel(status) {
      const labels = {
        active: "Activa",
        suspended: "Suspendida",
        expired: "Expirada",
        revoked: "Revocada"
      };

      return labels[status] || status || "N/D";
    }



     function getCheckTypeLabel(type) {
      const labels = {
        license_check: "Validación",
        activation_register: "Activación",
        admin_activation_status_update: "Cambio ADM"
      };

      return labels[type] || type || "N/D";
    }

    function getCheckResultLabel(result) {
      const labels = {
        valid: "Válida",
        requires_activation: "Requiere activación",
        activation_success: "Activación exitosa",
        already_activated: "Ya activado",
        device_limit_reached: "Límite alcanzado",
        device_suspended: "Equipo suspendido",
        device_revoked: "Equipo revocado",
        device_expired: "Equipo expirado",
        suspended: "Suspendido ADM",
        active: "Activado ADM",
        revoked: "Revocado ADM",
        not_found: "No encontrado",
        license_not_found: "Licencia no encontrada",
        company_not_active: "Empresa no activa",
        product_not_published: "Producto no publicado",
        expired: "Licencia vencida",
        not_started: "Licencia no vigente"
      };

      return labels[result] || result || "N/D";
    }




    function formatDate(value) {
      if (!value) return "N/D";

      const date = new Date(value);

      if (Number.isNaN(date.getTime())) {
        return value;
      }

      return date.toLocaleDateString("es-MX", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit"
      });
    }


        function formatDateTime(value) {
      if (!value) return "N/D";

      const date = new Date(value);

      if (Number.isNaN(date.getTime())) {
        return value;
      }

      return date.toLocaleString("es-MX", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit"
      });
    }


    function toIsoStartOfDay(value) {
      if (!value) return "";

      return `${value}T00:00:00.000Z`;
    }

    function toIsoEndOfDay(value) {
      if (!value) return "";

      return `${value}T23:59:59.000Z`;
    }

    function setDefaultDates() {
      const now = new Date();
      const nextYear = new Date(now);

      nextYear.setFullYear(now.getFullYear() + 1);

      if (licenseStartsAtInput && !licenseStartsAtInput.value) {
        licenseStartsAtInput.value = now.toISOString().slice(0, 10);
      }

      if (licenseExpiresAtInput && !licenseExpiresAtInput.value) {
        licenseExpiresAtInput.value = nextYear.toISOString().slice(0, 10);
      }
    }

    function buildLicensesUrl() {
      const params = new URLSearchParams();

      params.set("limit", "100");
      params.set("productId", SMARTPOZO360_PRODUCT_ID);

      const status = String(licenseStatusFilter?.value || "all");
      const companyId = String(licenseCompanyFilter?.value || "all");
      const search = String(licenseSearchInput?.value || "").trim();

      if (status !== "all") {
        params.set("status", status);
      }

      if (companyId !== "all") {
        params.set("companyId", companyId);
      }

      if (search) {
        params.set("search", search);
      }

      return `${ADMIN_LICENSES_URL}?${params.toString()}`;
    }

    function updateSummary(summary = {}) {
      if (summaryTotalLicenses) {
        summaryTotalLicenses.textContent = String(summary.total || 0);
      }

      if (summaryActiveLicenses) {
        summaryActiveLicenses.textContent = String(summary.active || 0);
      }

      if (summarySuspendedLicenses) {
        summarySuspendedLicenses.textContent = String(summary.suspended || 0);
      }

      if (summaryExpiredLicenses) {
        summaryExpiredLicenses.textContent = String(summary.expired || 0);
      }

      if (summaryRevokedLicenses) {
        summaryRevokedLicenses.textContent = String(summary.revoked || 0);
      }
    }

    function renderCompanies(companies = []) {
      const activeCompanies = companies.filter((company) => company.status !== "archived");

      if (licenseCompanySelect) {
        licenseCompanySelect.innerHTML = `
          <option value="">Seleccione empresa</option>
          ${activeCompanies.map((company) => `
            <option value="${escapeHtml(company.id)}">
              ${escapeHtml(company.name || "Empresa sin nombre")} — ${escapeHtml(company.status || "N/D")}
            </option>
          `).join("")}
        `;
      }

      if (licenseCompanyFilter) {
        licenseCompanyFilter.innerHTML = `
          <option value="all">Todas</option>
          ${activeCompanies.map((company) => `
            <option value="${escapeHtml(company.id)}">
              ${escapeHtml(company.name || "Empresa sin nombre")}
            </option>
          `).join("")}
        `;
      }
    }



         function buildActivationsUrl() {
      const params = new URLSearchParams();

      params.set("limit", "100");

      const status = String(activationStatusFilter?.value || "all");
      const search = String(activationSearchInput?.value || "").trim();

      if (status !== "all") {
        params.set("status", status);
      }

      if (search) {
        params.set("search", search);
      }

      return `${ADMIN_LICENSE_ACTIVATIONS_URL}?${params.toString()}`;
    }

    function renderActivations(activations = []) {
      if (!activationsTableBody) return;

      if (!activations.length) {
        activationsTableBody.innerHTML = `
          <tr>
            <td colspan="7" class="admin-empty">
              No hay equipos activados con esos filtros.
            </td>
          </tr>
        `;
        return;
      }

      activationsTableBody.innerHTML = activations.map((activation) => `
        <tr>
          <td>
            <strong>${escapeHtml(activation.machine_id || "Equipo sin ID")}</strong>
            <small>${escapeHtml(activation.device_label || "Sin etiqueta")}</small>
            <small>Versión app: ${escapeHtml(activation.app_version || "N/D")}</small>
          </td>

          <td>
            <strong>${escapeHtml(activation.license_code || "Licencia no encontrada")}</strong>
            <small>${escapeHtml(activation.license_name || "Sin nombre")}</small>
            <small>Vence: ${escapeHtml(formatDate(activation.license_expires_at))}</small>
          </td>

          <td>
            <strong>${escapeHtml(activation.company_name || "Empresa no encontrada")}</strong>
            <small>Estado empresa: ${escapeHtml(activation.company_status || "N/D")}</small>
          </td>

          <td>
            <strong>${escapeHtml(activation.product_name || "Software no encontrado")}</strong>
            <small>${escapeHtml(activation.product_slug || "N/D")}</small>
          </td>

          <td>
            <span class="admin-status-pill status-${escapeHtml(activation.status || "active")}">
              ${escapeHtml(getLicenseStatusLabel(activation.status))}
            </span>
          </td>

          <td>
            <strong>Activado: ${escapeHtml(formatDateTime(activation.activated_at))}</strong>
            <small>Último check: ${escapeHtml(formatDateTime(activation.last_check_at))}</small>
          </td>

          <td>
            <div class="admin-action-buttons activation-actions">
              <button
                class="btn btn-secondary"
                type="button"
                data-activation-id="${escapeHtml(activation.id)}"
                data-next-activation-status="active"
              >
                Reactivar
              </button>

              <button
                class="btn btn-secondary"
                type="button"
                data-activation-id="${escapeHtml(activation.id)}"
                data-next-activation-status="suspended"
              >
                Suspender
              </button>

              <button
                class="btn btn-secondary"
                type="button"
                data-activation-id="${escapeHtml(activation.id)}"
                data-next-activation-status="revoked"
              >
                Revocar
              </button>
            </div>
          </td>
        </tr>

      `).join("");
    }

    async function loadActivations() {
      const adminKey = getAdminKey();

      if (!adminKey) {
        setStatus("Ingrese la clave ADM para cargar activaciones.", "error");
        return;
      }

      if (refreshActivationsButton) refreshActivationsButton.disabled = true;

      try {
        const response = await fetch(buildActivationsUrl(), {
          method: "GET",
          mode: "cors",
          headers: {
            "x-admin-key": adminKey
          }
        });

        const result = await response.json();

        if (!response.ok || !result.ok) {
          throw new Error(result.message || "No se pudieron cargar las activaciones.");
        }

        renderActivations(result.activations || []);
      } catch (error) {
        renderActivations([]);
        setStatus(error.message || "Error al cargar activaciones.", "error");
      } finally {
        if (refreshActivationsButton) refreshActivationsButton.disabled = false;
      }
    }



         function buildChecksUrl() {
      const params = new URLSearchParams();

      params.set("limit", "100");

      const checkType = String(checkTypeFilter?.value || "all");
      const result = String(checkResultFilter?.value || "all");
      const search = String(checkSearchInput?.value || "").trim();

      if (checkType !== "all") {
        params.set("checkType", checkType);
      }

      if (result !== "all") {
        params.set("result", result);
      }

      if (search) {
        params.set("search", search);
      }

      return `${ADMIN_LICENSE_CHECKS_URL}?${params.toString()}`;
    }

    function renderLicenseChecks(checks = []) {
      if (!checksTableBody) return;

      if (!checks.length) {
        checksTableBody.innerHTML = `
          <tr>
            <td colspan="7" class="admin-empty">
              No hay eventos de licencia con esos filtros.
            </td>
          </tr>
        `;
        return;
      }

      checksTableBody.innerHTML = checks.map((check) => `
        <tr>
          <td>
            <strong>${escapeHtml(formatDateTime(check.checked_at))}</strong>
          </td>

          <td>
            <strong>${escapeHtml(check.license_id || "Licencia no encontrada")}</strong>
            <small>${escapeHtml(check.license_name || "Sin nombre")}</small>
            <small>Estado licencia: ${escapeHtml(getLicenseStatusLabel(check.license_status))}</small>
          </td>

          <td>
            <strong>${escapeHtml(check.machine_id || "Sin equipo")}</strong>
            <small>${escapeHtml(check.device_label || "Sin etiqueta")}</small>
            <small>Activación: ${escapeHtml(getLicenseStatusLabel(check.activation_status))}</small>
            <small>Versión: ${escapeHtml(check.app_version || "N/D")}</small>
          </td>

          <td>
            <span class="admin-status-pill status-${escapeHtml(check.check_type || "default")}">
              ${escapeHtml(getCheckTypeLabel(check.check_type))}
            </span>
            <small>${escapeHtml(check.check_type || "N/D")}</small>
          </td>

          <td>
            <strong>${escapeHtml(getCheckResultLabel(check.result))}</strong>
            <small>${escapeHtml(check.result || "N/D")}</small>
          </td>

          <td>
            <strong>${escapeHtml(check.company_name || "Empresa no encontrada")}</strong>
            <small>${escapeHtml(check.product_name || "Software no encontrado")}</small>
            <small>${escapeHtml(check.product_slug || "N/D")}</small>
          </td>

          <td>
            <strong>IP: ${escapeHtml(check.ip_address || "N/D")}</strong>
            <small>${escapeHtml(String(check.user_agent || "N/D").slice(0, 90))}</small>
          </td>
        </tr>
      `).join("");
    }

    async function loadLicenseChecks() {
      const adminKey = getAdminKey();

      if (!adminKey) {
        setStatus("Ingrese la clave ADM para cargar historial de licencias.", "error");
        return;
      }

      if (refreshChecksButton) refreshChecksButton.disabled = true;

      try {
        const response = await fetch(buildChecksUrl(), {
          method: "GET",
          mode: "cors",
          headers: {
            "x-admin-key": adminKey
          }
        });

        const result = await response.json();

        if (!response.ok || !result.ok) {
          throw new Error(result.message || "No se pudo cargar el historial de licencias.");
        }

        renderLicenseChecks(result.checks || []);
      } catch (error) {
        renderLicenseChecks([]);
        setStatus(error.message || "Error al cargar historial de licencias.", "error");
      } finally {
        if (refreshChecksButton) refreshChecksButton.disabled = false;
      }
    }



    
     async function updateActivationStatus(activationId, nextStatus, button) {
      const adminKey = getAdminKey();

      if (!adminKey) {
        setStatus("Ingrese la clave ADM antes de actualizar activaciones.", "error");
        return;
      }

      if (!activationId || !nextStatus) {
        setStatus("Activación no válida.", "error");
        return;
      }

      const statusLabel = getLicenseStatusLabel(nextStatus);

      const note = window.prompt(
        `Nota opcional para cambiar el equipo a ${statusLabel}:`,
        `Cambio de estado de activación a ${statusLabel} desde panel ADM.`
      );

      if (note === null) {
        return;
      }

      setStatus("Actualizando estado del equipo...");

      if (button) {
        button.disabled = true;
      }

      try {
        const response = await fetch(ADMIN_LICENSE_ACTIVATIONS_UPDATE_STATUS_URL, {
          method: "POST",
          mode: "cors",
          headers: {
            "x-admin-key": adminKey,
            "content-type": "text/plain;charset=UTF-8"
          },
          body: JSON.stringify({
            activationId,
            status: nextStatus,
            note
          })
        });

        const result = await response.json();

        if (!response.ok || !result.ok) {
          throw new Error(result.message || "No se pudo actualizar la activación.");
        }

        setStatus(result.message || "Activación actualizada correctamente.", "success");

        await loadActivations();
        await loadLicenses();
      } catch (error) {
        setStatus(error.message || "Error al actualizar activación.", "error");
      } finally {
        if (button) {
          button.disabled = false;
        }
      }
    }



    function renderLicenses(licenses = []) {
      if (!licensesTableBody) return;

      if (!licenses.length) {
        licensesTableBody.innerHTML = `
          <tr>
            <td colspan="7" class="admin-empty">
              No hay licencias registradas con esos filtros.
            </td>
          </tr>
        `;
        return;
      }

      licensesTableBody.innerHTML = licenses.map((license) => `
        <tr>
          <td>
            <strong>${escapeHtml(license.license_name || "Licencia sin nombre")}</strong>
            <small>ID: ${escapeHtml(license.license_id || "N/D")}</small>
            <small>Interno: ${escapeHtml(String(license.id || "").slice(0, 8))}...</small>
          </td>

          <td>
            <strong>${escapeHtml(license.company_name || "Empresa no encontrada")}</strong>
            <small>${escapeHtml(license.company_legal_name || "Sin razón social")}</small>
            <small>Estado empresa: ${escapeHtml(license.company_status || "N/D")}</small>
          </td>

          <td>
            <strong>${escapeHtml(license.product_name || "Software no encontrado")}</strong>
            <small>${escapeHtml(license.product_slug || "N/D")}</small>
          </td>

          <td>
            <span class="admin-status-pill status-${escapeHtml(license.status || "active")}">
              ${escapeHtml(getLicenseStatusLabel(license.status))}
            </span>
          </td>

          <td>
            <strong>Inicio: ${escapeHtml(formatDate(license.starts_at || license.created_at))}</strong>
            <small>Vence: ${escapeHtml(formatDate(license.expires_at))}</small>
          </td>

          <td>
            <strong>Usuarios: ${escapeHtml(license.max_users || 1)}</strong>
            <small>Dispositivos: ${escapeHtml(license.max_devices || 1)}</small>
            <small>Activaciones: ${escapeHtml(license.activations_count || 0)}</small>
          </td>

          <td>
            <div class="admin-action-buttons license-actions">
              <button
                class="btn btn-secondary"
                type="button"
                data-license-id="${escapeHtml(license.id)}"
                data-next-status="active"
              >
                Activar
              </button>

              <button
                class="btn btn-secondary"
                type="button"
                data-license-id="${escapeHtml(license.id)}"
                data-next-status="suspended"
              >
                Suspender
              </button>

              <button
                class="btn btn-secondary"
                type="button"
                data-license-id="${escapeHtml(license.id)}"
                data-next-status="revoked"
              >
                Revocar
              </button>
            </div>
          </td>
        </tr>
      `).join("");
    }

    async function loadCompanies() {
      const adminKey = getAdminKey();

      if (!adminKey) {
        setStatus("Ingrese la clave ADM para cargar empresas.", "error");
        return;
      }

      const response = await fetch(`${ADMIN_COMPANIES_URL}?limit=100`, {
        method: "GET",
        mode: "cors",
        headers: {
          "x-admin-key": adminKey
        }
      });

      const result = await response.json();

      if (!response.ok || !result.ok) {
        throw new Error(result.message || "No se pudieron cargar las empresas.");
      }

      renderCompanies(result.companies || []);
    }

    async function loadLicenses() {
      const adminKey = getAdminKey();

      if (!adminKey) {
        setStatus("Ingrese la clave ADM para cargar licencias.", "error");
        return;
      }

      setStatus("Cargando licencias...");

      if (loadLicensesButton) loadLicensesButton.disabled = true;
      if (refreshLicensesButton) refreshLicensesButton.disabled = true;

      try {
        await loadCompanies();

        const response = await fetch(buildLicensesUrl(), {
          method: "GET",
          mode: "cors",
          headers: {
            "x-admin-key": adminKey
          }
        });

        const result = await response.json();

        if (!response.ok || !result.ok) {
          throw new Error(result.message || "No se pudieron cargar las licencias.");
        }

        renderLicenses(result.licenses || []);
        updateSummary(result.summary || {});

        await loadActivations();

        await loadLicenseChecks();


        setStatus(
          `Licencias cargadas: ${result.count || 0} de ${result.total || 0}`,
          "success"
        );
      } catch (error) {
        renderLicenses([]);
        updateSummary({});
        setStatus(error.message || "Error al cargar licencias.", "error");
      } finally {
        if (loadLicensesButton) loadLicensesButton.disabled = false;
        if (refreshLicensesButton) refreshLicensesButton.disabled = false;
      }
    }

    async function createLicense(event) {
      event.preventDefault();

      const adminKey = getAdminKey();

      if (!adminKey) {
        setStatus("Ingrese la clave ADM antes de crear licencias.", "error");
        return;
      }

      const companyId = String(licenseCompanySelect?.value || "").trim();

      if (!companyId) {
        setStatus("Seleccione una empresa para la licencia.", "error");
        return;
      }

      setStatus("Creando licencia...");

      const payload = {
        companyId,
        productId: SMARTPOZO360_PRODUCT_ID,
        licenseName: String(licenseNameInput?.value || "").trim(),
        licenseId: String(licenseCodeInput?.value || "").trim(),
        status: String(licenseStatusInput?.value || "active"),
        startsAt: toIsoStartOfDay(String(licenseStartsAtInput?.value || "")),
        expiresAt: toIsoEndOfDay(String(licenseExpiresAtInput?.value || "")),
        maxUsers: Number(licenseMaxUsersInput?.value || 3),
        maxDevices: Number(licenseMaxDevicesInput?.value || 1),
        notes: String(licenseNotesInput?.value || "").trim()
      };

      try {
        const response = await fetch(ADMIN_LICENSES_URL, {
          method: "POST",
          mode: "cors",
          headers: {
            "x-admin-key": adminKey,
            "content-type": "text/plain;charset=UTF-8"
          },
          body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (!response.ok || !result.ok) {
          throw new Error(result.message || "No se pudo crear la licencia.");
        }

        if (licenseNameInput) licenseNameInput.value = "";
        if (licenseCodeInput) licenseCodeInput.value = "";
        if (licenseNotesInput) licenseNotesInput.value = "";

        setDefaultDates();
        setStatus(result.message || "Licencia creada correctamente.", "success");
        await loadLicenses();
      } catch (error) {
        setStatus(error.message || "Error al crear licencia.", "error");
      }
    }

    async function updateLicenseStatus(licenseId, nextStatus, button) {
      const adminKey = getAdminKey();

      if (!adminKey) {
        setStatus("Ingrese la clave ADM antes de actualizar licencias.", "error");
        return;
      }

      if (!licenseId || !nextStatus) {
        setStatus("Licencia no válida.", "error");
        return;
      }

      const note = window.prompt(
        `Nota opcional para cambiar la licencia a ${getLicenseStatusLabel(nextStatus)}:`,
        `Cambio de estado a ${getLicenseStatusLabel(nextStatus)} desde panel ADM.`
      );

      if (note === null) {
        return;
      }

      setStatus("Actualizando licencia...");

      if (button) {
        button.disabled = true;
      }

      try {
        const response = await fetch(ADMIN_LICENSE_STATUS_URL, {
          method: "POST",
          mode: "cors",
          headers: {
            "x-admin-key": adminKey,
            "content-type": "text/plain;charset=UTF-8"
          },
          body: JSON.stringify({
            id: licenseId,
            status: nextStatus,
            note
          })
        });

        const result = await response.json();

        if (!response.ok || !result.ok) {
          throw new Error(result.message || "No se pudo actualizar la licencia.");
        }

        setStatus(result.message || "Licencia actualizada correctamente.", "success");
        await loadLicenses();
      } catch (error) {
        setStatus(error.message || "Error al actualizar licencia.", "error");
      } finally {
        if (button) {
          button.disabled = false;
        }
      }
    }

    loadLicensesButton?.addEventListener("click", loadLicenses);
    refreshLicensesButton?.addEventListener("click", loadLicenses);

     refreshActivationsButton?.addEventListener("click", loadActivations);
    activationStatusFilter?.addEventListener("change", loadActivations);

    activationSearchInput?.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        loadActivations();
      }
    });



     refreshChecksButton?.addEventListener("click", loadLicenseChecks);
    checkTypeFilter?.addEventListener("change", loadLicenseChecks);
    checkResultFilter?.addEventListener("change", loadLicenseChecks);

    checkSearchInput?.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        loadLicenseChecks();
      }
    });


    createLicenseForm?.addEventListener("submit", createLicense);

    licenseStatusFilter?.addEventListener("change", loadLicenses);
    licenseCompanyFilter?.addEventListener("change", loadLicenses);

    licenseSearchInput?.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        loadLicenses();
      }
    });

    clearLicenseFiltersButton?.addEventListener("click", () => {
      if (licenseStatusFilter) licenseStatusFilter.value = "all";
      if (licenseCompanyFilter) licenseCompanyFilter.value = "all";
      if (licenseSearchInput) licenseSearchInput.value = "";
      loadLicenses();
    });

    licensesTableBody?.addEventListener("click", async (event) => {
      const target = event.target;

      if (!(target instanceof Element)) {
        return;
      }

      const button = target.closest("button[data-license-id]");

      if (!button) {
        return;
      }

      const licenseId = button.dataset.licenseId || "";
      const nextStatus = button.dataset.nextStatus || "";

      await updateLicenseStatus(licenseId, nextStatus, button);
    });


     activationsTableBody?.addEventListener("click", async (event) => {
      const target = event.target;

      if (!(target instanceof Element)) {
        return;
      }

      const button = target.closest("button[data-activation-id]");

      if (!button) {
        return;
      }

      const activationId = button.dataset.activationId || "";
      const nextStatus = button.dataset.nextActivationStatus || "";

      await updateActivationStatus(activationId, nextStatus, button);
    });



    setDefaultDates();
  </script>
</BaseLayout>


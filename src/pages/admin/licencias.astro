    async function loadLicenseAlerts() {
      const adminKey = getAdminKey();

      if (!adminKey) {
        setLicenseAlertsStatus("Ingrese la clave ADM para cargar alertas finales.", "error");
        return;
      }

      if (refreshLicenseAlertsButton) {
        refreshLicenseAlertsButton.disabled = true;
      }

      try {
        setLicenseAlertsStatus("Cargando alertas finales de licencias...");

        const response = await fetch(buildLicenseAlertsUrl(), {
          method: "GET",
          mode: "cors",
          headers: {
            "x-admin-key": adminKey
          }
        });

        const result = await response.json();

        if (!response.ok || !result.ok) {
          throw new Error(result.message || "No se pudieron cargar las alertas de licencias.");
        }

        renderLicenseAlerts(result);

        setLicenseAlertsStatus(
          `Alertas cargadas. Riesgo: ${result.risk?.label || "N/D"}.`,
          "success"
        );
      } catch (error) {
        setLicenseAlertsStatus(error.message || "Error al cargar alertas finales.", "error");
      } finally {
        if (refreshLicenseAlertsButton) {
          refreshLicenseAlertsButton.disabled = false;
        }
      }
    }

    async function sendLicenseAlertsEmail() {
      const adminKey = getAdminKey();

      if (!adminKey) {
        setLicenseAlertsStatus("Ingrese la clave ADM para enviar alerta por correo.", "error");
        return;
      }

      const days = Number(licenseAlertsDaysFilter?.value || 30);
      const to = String(licenseAlertsEmailInput?.value || "").trim();

      if (sendLicenseAlertsEmailButton) {
        sendLicenseAlertsEmailButton.disabled = true;
      }

      try {
        setLicenseAlertsStatus("Enviando correo de alertas ADM...");

        const response = await fetch(ADMIN_LICENSE_ALERTS_SEND_URL, {
          method: "POST",
          mode: "cors",
          headers: {
            "x-admin-key": adminKey,
            "content-type": "text/plain;charset=UTF-8"
          },
          body: JSON.stringify({
            days,
            to
          })
        });

        const result = await response.json();

        if (!response.ok || !result.ok) {
          throw new Error(result.message || "No se pudo enviar el correo de alertas.");

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionTitle from "../../components/SectionTitle.astro";
---

<BaseLayout title="Usuarios ADM | SEAZEP">
  <Header active="admin" />

  <main>
    <section class="section">
      <SectionTitle
        eyebrow="ADM SEAZEP"
        title="Gestión de usuarios registrados."
        text="Administra solicitudes de registro, aprueba usuarios, suspende accesos y consulta el estado de cuentas SEAZEP."
      />

      <div class="admin-access-panel">
        <div>
          <h3>Acceso temporal ADM</h3>
          <p>
            Ingrese la clave administrativa para consultar y gestionar usuarios.
            Esta clave corresponde al secreto ADMIN_API_KEY del Worker.
          </p>
        </div>

        <div class="admin-key-form">
          <input
            class="input"
            id="adminApiKey"
            type="password"
            placeholder="Clave ADM temporal"
            autocomplete="off"
          />

          <button class="btn btn-primary" id="loadUsersButton" type="button">
            Cargar usuarios
          </button>

          <a class="btn btn-ghost" href="/admin/dashboard">
            Volver a solicitudes
          </a>

          <a class="btn btn-ghost" href="/admin/empresas">
  Gestionar empresas
</a>

        </div>

        <p id="adminUsersStatus" class="form-status" aria-live="polite"></p>
      </div>

      <section class="admin-filter-panel">
        <div class="admin-filter-header">
          <div>
            <span class="eyebrow">Filtros ADM</span>
            <h3>Seguimiento de usuarios</h3>
          </div>

          <button class="btn btn-secondary" type="button" id="clearUserFiltersButton">
            Limpiar filtros
          </button>
        </div>

        <div class="admin-filter-grid">
          <label class="admin-filter-field">
            <span>Estado</span>
            <select class="input" id="userStatusFilter">
              <option value="all">Todos los estados</option>
              <option value="pending">Pendientes</option>
              <option value="active">Activos</option>
              <option value="suspended">Suspendidos</option>
            </select>
          </label>

          <label class="admin-filter-field admin-filter-search">
            <span>Buscar</span>
            <input
              class="input"
              id="userSearchInput"
              placeholder="Nombre, correo, empresa, teléfono o rol"
            />
          </label>
        </div>

        <div class="admin-summary-grid users-summary-grid">
          <article class="admin-summary-card">
            <span>Total</span>
            <strong id="summaryUsersTotal">0</strong>
          </article>

          <article class="admin-summary-card">
            <span>Pendientes</span>
            <strong id="summaryUsersPending">0</strong>
          </article>

          <article class="admin-summary-card">
            <span>Activos</span>
            <strong id="summaryUsersActive">0</strong>
          </article>

          <article class="admin-summary-card danger">
            <span>Suspendidos</span>
            <strong id="summaryUsersSuspended">0</strong>
          </article>
        </div>
      </section>

      <section class="admin-requests-section">
        <div class="admin-section-header">
          <div>
            <span class="eyebrow">Usuarios registrados</span>
            <h2>Cuentas creadas desde SEAZEP-WEB.</h2>
          </div>

          <button class="btn btn-ghost" id="refreshUsersButton" type="button">
            Actualizar
          </button>
        </div>

        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Registro</th>
                <th>Usuario</th>
                <th>Empresa</th>
                <th>Contacto</th>
                <th>Rol</th>
                <th>Estado</th>
                <th>Actualizado</th>
                <th>Acciones</th>
              </tr>
            </thead>

            <tbody id="usersTableBody">
              <tr>
                <td colspan="8" class="admin-empty">
                  Ingrese la clave ADM y presione “Cargar usuarios”.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </section>
  </main>

  <Footer />

  <script>
    const ADMIN_USERS_BASE_URL = "https://seazep-api.seazepfco.workers.dev/admin/users";
    const ADMIN_UPDATE_USER_STATUS_URL = "https://seazep-api.seazepfco.workers.dev/admin/users/update-status";

    const adminKeyInput = document.getElementById("adminApiKey");
    const loadUsersButton = document.getElementById("loadUsersButton");
    const refreshUsersButton = document.getElementById("refreshUsersButton");
    const statusEl = document.getElementById("adminUsersStatus");
    const usersTableBody = document.getElementById("usersTableBody");

    const userStatusFilter = document.getElementById("userStatusFilter");
    const userSearchInput = document.getElementById("userSearchInput");
    const clearUserFiltersButton = document.getElementById("clearUserFiltersButton");

    const summaryUsersTotal = document.getElementById("summaryUsersTotal");
    const summaryUsersPending = document.getElementById("summaryUsersPending");
    const summaryUsersActive = document.getElementById("summaryUsersActive");
    const summaryUsersSuspended = document.getElementById("summaryUsersSuspended");

    function getAdminKey() {
      return String(adminKeyInput?.value || "").trim();
    }

    function setStatus(message, type = "") {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.className = type ? `form-status ${type}` : "form-status";
    }

    function escapeHtml(value) {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function formatDate(value) {
      if (!value) return "N/D";

      const date = new Date(value);

      if (Number.isNaN(date.getTime())) {
        return value;
      }

      return date.toLocaleString("es-MX", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit"
      });
    }

    function getUserStatusLabel(status) {
      const labels = {
        pending: "Pendiente",
        active: "Activo",
        suspended: "Suspendido"
      };

      return labels[status] || status || "Pendiente";
    }

    function getUserStatusClass(status) {
      return `status-${String(status || "pending").replace(/[^a-z0-9_-]/gi, "")}`;
    }

    function buildUsersUrl() {
      const params = new URLSearchParams();

      params.set("limit", "50");

      const status = String(userStatusFilter?.value || "all").trim();
      const search = String(userSearchInput?.value || "").trim();

      if (status && status !== "all") {
        params.set("status", status);
      }

      if (search) {
        params.set("search", search);
      }

      return `${ADMIN_USERS_BASE_URL}?${params.toString()}`;
    }

    function updateUserSummary(summary = {}) {
      if (summaryUsersTotal) summaryUsersTotal.textContent = String(summary.total || 0);
      if (summaryUsersPending) summaryUsersPending.textContent = String(summary.pending || 0);
      if (summaryUsersActive) summaryUsersActive.textContent = String(summary.active || 0);
      if (summaryUsersSuspended) summaryUsersSuspended.textContent = String(summary.suspended || 0);
    }

    function buildUserActionButtons(user) {
      const currentStatus = user.status || "pending";

      const actions = [
        { status: "active", label: "Aprobar / Activar", className: "ok" },
        { status: "suspended", label: "Suspender", className: "danger" },
        { status: "pending", label: "Marcar pendiente", className: "warn" }
      ];

      return `
        <div class="admin-action-buttons">
          ${actions.map((action) => `
            <button
              class="admin-mini-btn ${action.className}"
              type="button"
              data-user-id="${escapeHtml(user.id)}"
              data-next-status="${escapeHtml(action.status)}"
              ${currentStatus === action.status ? "disabled" : ""}
            >
              ${escapeHtml(action.label)}
            </button>
          `).join("")}
        </div>
      `;
    }

    function renderUsers(users) {
      if (!usersTableBody) return;

      if (!users.length) {
        usersTableBody.innerHTML = `
          <tr>
            <td colspan="8" class="admin-empty">
              No hay usuarios registrados con esos filtros.
            </td>
          </tr>
        `;
        return;
      }

      usersTableBody.innerHTML = users.map((user) => `
        <tr>
          <td>${escapeHtml(formatDate(user.created_at))}</td>

          <td>
            <strong>${escapeHtml(user.full_name || "Sin nombre")}</strong>
            <small>${escapeHtml(user.email || "Sin correo")}</small>
          </td>

          <td>
            <strong>${escapeHtml(user.company_name || "Sin empresa")}</strong>
            <small>${escapeHtml(user.source || "website")}</small>
          </td>

          <td>
            <strong>${escapeHtml(user.phone || "Sin teléfono")}</strong>
            <small>ID: ${escapeHtml(String(user.id || "").slice(0, 8))}...</small>
          </td>

          <td>${escapeHtml(user.role || "user")}</td>

          <td>
            <span class="admin-status-pill ${getUserStatusClass(user.status)}">
              ${escapeHtml(getUserStatusLabel(user.status))}
            </span>
          </td>

          <td>${escapeHtml(formatDate(user.updated_at))}</td>

          <td>${buildUserActionButtons(user)}</td>
        </tr>
      `).join("");
    }

    async function loadUsers() {
      const adminKey = getAdminKey();

      if (!adminKey) {
        setStatus("Ingrese la clave ADM para cargar usuarios.", "error");
        return;
      }

      setStatus("Cargando usuarios...");

      if (loadUsersButton) loadUsersButton.disabled = true;
      if (refreshUsersButton) refreshUsersButton.disabled = true;

      try {
        const response = await fetch(buildUsersUrl(), {
          method: "GET",
          mode: "cors",
          headers: {
            "x-admin-key": adminKey
          }
        });

        const result = await response.json();

        if (!response.ok || !result.ok) {
          throw new Error(result.message || "No se pudieron cargar los usuarios.");
        }

        renderUsers(result.users || []);
        updateUserSummary(result.summary || {});

        setStatus(
          `Usuarios cargados: ${result.count || 0} de ${result.total || 0}`,
          "success"
        );
      } catch (error) {
        renderUsers([]);
        updateUserSummary({});
        setStatus(error.message || "Error al cargar usuarios.", "error");
      } finally {
        if (loadUsersButton) loadUsersButton.disabled = false;
        if (refreshUsersButton) refreshUsersButton.disabled = false;
      }
    }

    async function updateUserStatus(userId, status) {
      const adminKey = getAdminKey();

      if (!adminKey) {
        setStatus("Ingrese la clave ADM antes de actualizar usuarios.", "error");
        return;
      }

      if (!userId || !status) {
        setStatus("Usuario o estado no válido.", "error");
        return;
      }

      const note = window.prompt(
        `Nota opcional para cambiar usuario a: ${getUserStatusLabel(status)}`,
        ""
      );

      if (note === null) {
        return;
      }

      setStatus("Actualizando estado de usuario...");

      try {
        const response = await fetch(ADMIN_UPDATE_USER_STATUS_URL, {
          method: "POST",
          mode: "cors",
          headers: {
            "x-admin-key": adminKey,
            "content-type": "text/plain;charset=UTF-8"
          },
          body: JSON.stringify({
            userId,
            status,
            note
          })
        });

        const result = await response.json();

        if (!response.ok || !result.ok) {
          throw new Error(result.message || "No se pudo actualizar el usuario.");
        }

        setStatus("Estado de usuario actualizado correctamente.", "success");
        await loadUsers();
      } catch (error) {
        setStatus(error.message || "Error al actualizar usuario.", "error");
      }
    }

    usersTableBody?.addEventListener("click", async (event) => {
      const button = event.target.closest("[data-user-id][data-next-status]");

      if (!button) return;

      const userId = button.dataset.userId;
      const status = button.dataset.nextStatus;

      button.disabled = true;

      try {
        await updateUserStatus(userId, status);
      } finally {
        button.disabled = false;
      }
    });

    userStatusFilter?.addEventListener("change", loadUsers);

    userSearchInput?.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        loadUsers();
      }
    });

    clearUserFiltersButton?.addEventListener("click", () => {
      if (userStatusFilter) userStatusFilter.value = "all";
      if (userSearchInput) userSearchInput.value = "";
      loadUsers();
    });

    loadUsersButton?.addEventListener("click", loadUsers);
    refreshUsersButton?.addEventListener("click", loadUsers);
  </script>
</BaseLayout>
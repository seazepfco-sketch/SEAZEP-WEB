        if (!limitBlocksResponse.ok || !limitBlocksResult.ok) {
          throw new Error(limitBlocksResult.message || "No se pudo cargar bloqueos por límite.");
        }

        const activations = activationsResult.activations || [];

        const activeDevices = activations.filter((item) => item.status === "active").length;
        const suspendedDevices = activations.filter((item) => item.status === "suspended").length;
        const revokedDevices = activations.filter((item) => item.status === "revoked").length;

        setLicenseOverviewValues({
          activeLicenses: licensesResult.summary?.active || 0,

  <script>
const ADMIN_REQUESTS_BASE_URL = "https://seazep-api.seazepfco.workers.dev/admin/requests";
const ADMIN_UPDATE_STATUS_URL = "https://seazep-api.seazepfco.workers.dev/admin/requests/update-status";
const ADMIN_REQUEST_NOTES_URL = "https://seazep-api.seazepfco.workers.dev/admin/requests/notes";
const ADMIN_CONVERT_REQUEST_TO_COMPANY_URL = "https://seazep-api.seazepfco.workers.dev/admin/requests/convert-to-company";

const ADMIN_LICENSES_URL = "https://seazep-api.seazepfco.workers.dev/admin/licenses";
const ADMIN_LICENSE_ACTIVATIONS_URL = "https://seazep-api.seazepfco.workers.dev/admin/license-activations";
const ADMIN_LICENSE_CHECKS_URL = "https://seazep-api.seazepfco.workers.dev/admin/license-checks";

const ADMIN_LICENSE_ACTIVITY_URL = "https://seazep-api.seazepfco.workers.dev/admin/license-activity";
const ADMIN_LICENSE_OFFLINE_DAYS_URL = "https://seazep-api.seazepfco.workers.dev/admin/licenses/update-offline-days";



    const keyInput = document.getElementById("adminApiKey");
    const loadButton = document.getElementById("loadRequestsButton");
    const refreshButton = document.getElementById("refreshRequestsButton");
    const statusEl = document.getElementById("adminStatus");

    const licenseOverviewActive = document.getElementById("licenseOverviewActive");
    const licenseOverviewDevices = document.getElementById("licenseOverviewDevices");
    const licenseOverviewSuspended = document.getElementById("licenseOverviewSuspended");
    const licenseOverviewRevoked = document.getElementById("licenseOverviewRevoked");
    const licenseOverviewChecks = document.getElementById("licenseOverviewChecks");
    const licenseOverviewLimitBlocks = document.getElementById("licenseOverviewLimitBlocks");
    const licenseOverviewStatus = document.getElementById("licenseOverviewStatus");

    const refreshLicenseAlertsButton = document.getElementById("refreshLicenseAlertsButton");
    const alertExpiringLicenses = document.getElementById("alertExpiringLicenses");
    const alertExpiredLicenses = document.getElementById("alertExpiredLicenses");
    const alertSuspendedDevices = document.getElementById("alertSuspendedDevices");
    const alertRevokedDevices = document.getElementById("alertRevokedDevices");
    const alertLimitBlocks = document.getElementById("alertLimitBlocks");
    const licenseAlertsList = document.getElementById("licenseAlertsList");
    const licenseAlertsStatus = document.getElementById("licenseAlertsStatus");

    const refreshLicenseActivityButton = document.getElementById("refreshLicenseActivityButton");
    const activityTodayTotal = document.getElementById("activityTodayTotal");
    const activityTodayAdminLogins = document.getElementById("activityTodayAdminLogins");
    const activityTodayHeartbeats = document.getElementById("activityTodayHeartbeats");
    const activityTodayWellSaves = document.getElementById("activityTodayWellSaves");
    const activityTodayWellUpdates = document.getElementById("activityTodayWellUpdates");
    const activityInactiveDevices = document.getElementById("activityInactiveDevices");
    const licenseActivityTableBody = document.getElementById("licenseActivityTableBody");
    const licenseActivityStatus = document.getElementById("licenseActivityStatus");
    const licenseOfflineIdInput = document.getElementById("licenseOfflineIdInput");
    const licenseOfflineDaysInput = document.getElementById("licenseOfflineDaysInput");
    const updateLicenseOfflineDaysButton = document.getElementById("updateLicenseOfflineDaysButton");



    const tableBody = document.getElementById("requestsTableBody");
    const totalRequestsEl = document.getElementById("totalRequests");
    const newRequestsEl = document.getElementById("newRequests");


    const statusFilter = document.getElementById("adminStatusFilter");
const interestFilter = document.getElementById("adminInterestFilter");
const searchInput = document.getElementById("adminSearchInput");
const clearFiltersButton = document.getElementById("adminClearFiltersButton");

const summaryTotal = document.getElementById("summaryTotal");
const summaryNew = document.getElementById("summaryNew");
const summaryContacted = document.getElementById("summaryContacted");
const summaryNegotiation = document.getElementById("summaryNegotiation");
const summaryClosed = document.getElementById("summaryClosed");
const summaryDiscarded = document.getElementById("summaryDiscarded");


    function setStatus(message, type = "") {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.className = type ? `form-status ${type}` : "form-status";
    }

    function escapeHtml(value) {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }



    function buildRequestsUrl() {
  const params = new URLSearchParams();

  params.set("limit", "50");

  const status = String(statusFilter?.value || "all").trim();
  const interestArea = String(interestFilter?.value || "all").trim();
  const search = String(searchInput?.value || "").trim();

  if (status && status !== "all") {
    params.set("status", status);
  }

  if (interestArea && interestArea !== "all") {
    params.set("interestArea", interestArea);
  }

  if (search) {
    params.set("search", search);
  }

  return `${ADMIN_REQUESTS_BASE_URL}?${params.toString()}`;
}

function updateSummary(summary = {}) {
  if (summaryTotal) summaryTotal.textContent = String(summary.total || 0);
  if (summaryNew) summaryNew.textContent = String(summary.new || 0);
  if (summaryContacted) summaryContacted.textContent = String(summary.contacted || 0);
  if (summaryNegotiation) summaryNegotiation.textContent = String(summary.negotiation || 0);
  if (summaryClosed) summaryClosed.textContent = String(summary.closed || 0);
  if (summaryDiscarded) summaryDiscarded.textContent = String(summary.discarded || 0);
}



    function formatDate(value) {
      if (!value) return "N/D";

      const date = new Date(value);

      if (Number.isNaN(date.getTime())) {
        return value;
      }

      return date.toLocaleString("es-MX", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit"
      });
    }

    function renderRequests(requests) {
      if (!tableBody) return;

      if (!requests.length) {
        tableBody.innerHTML = `
          <tr>
            <td colspan="8" class="admin-empty">
              No hay solicitudes registradas.
            </td>
          </tr>
        `;
        return;
      }

      tableBody.innerHTML = requests.map((item) => `
        <tr>
          <td>${escapeHtml(formatDate(item.created_at))}</td>
          <td>
            <strong>${escapeHtml(item.company_name)}</strong>
            <small>${escapeHtml(item.source || "website")}</small>
          </td>
          <td>
            <strong>${escapeHtml(item.contact_name)}</strong>
            <small>${escapeHtml(item.contact_position || "Sin cargo")}</small>
          </td>
          <td>
            <strong>${escapeHtml(item.contact_email)}</strong>
            <small>${escapeHtml(item.contact_phone || "Sin teléfono")}</small>
          </td>
          <td>${escapeHtml(item.interest_area)}</td>
          <td>
            <span class="admin-status-pill status-${escapeHtml(item.status || "new")}">
  ${escapeHtml(getStatusLabel(item.status))}
</span>
          </td>
          <td class="admin-message-cell">${escapeHtml(item.message || "Sin mensaje")}</td>
<td>${buildActionButtons(item)}</td>
        </tr>
      `).join("");
    }


    function getAdminKey() {
  return String(keyInput?.value || "").trim();
}

function getStatusLabel(status) {
  const labels = {
    new: "Nueva",
    contacted: "Contactada",
    negotiation: "Negociación",
    closed: "Cerrada",
    discarded: "Descartada"
  };

  return labels[status] || status || "Nueva";
}

function buildActionButtons(item) {
  const currentStatus = item.status || "new";

  const actions = [
    { status: "contacted", label: "Contactada", className: "info" },
    { status: "negotiation", label: "Negociación", className: "warn" },
    { status: "closed", label: "Cerrar", className: "ok" },
    { status: "discarded", label: "Descartar", className: "danger" }
  ];

  return `
    <div class="admin-action-buttons">
      ${actions.map((action) => `
        <button
          class="admin-mini-btn ${action.className}"
          type="button"
          data-request-id="${escapeHtml(item.id)}"
          data-next-status="${escapeHtml(action.status)}"
          ${currentStatus === action.status ? "disabled" : ""}
        >
          ${escapeHtml(action.label)}
        </button>
      `).join("")}

      <button
        class="admin-mini-btn note"
        type="button"
        data-request-id="${escapeHtml(item.id)}"
        data-note-action="add"
      >
        Agregar nota
      </button>

      <button
        class="admin-mini-btn note"
        type="button"
        data-request-id="${escapeHtml(item.id)}"
        data-note-action="view"
      >
        Ver notas
      </button>

      <button
  class="admin-mini-btn convert"
  type="button"
  data-request-id="${escapeHtml(item.id)}"
  data-request-action="convert-company"
>
  Convertir en empresa
</button>
    </div>
  `;
}




async function updateRequestStatus(id, status) {

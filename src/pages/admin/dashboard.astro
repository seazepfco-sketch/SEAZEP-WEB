    loadButton?.addEventListener("click", loadAdminDashboardData);
    refreshButton?.addEventListener("click", loadAdminDashboardData);

     refreshLicenseAlertsButton?.addEventListener("click", loadLicenseAlerts);

     refreshLicenseActivityButton?.addEventListener("click", loadLicenseActivity);
    updateLicenseOfflineDaysButton?.addEventListener("click", updateLicenseOfflineDays);


    tableBody?.addEventListener("click", async (event) => {
  const button = event.target.closest("[data-request-id]");

  if (!button) return;

  const id = button.dataset.requestId;
  const status = button.dataset.nextStatus;
  const noteAction = button.dataset.noteAction;
  const requestAction = button.dataset.requestAction;

  if (!id) return;

  button.disabled = true;

  try {
    if (requestAction === "convert-company") {
      await convertRequestToCompany(id);
      return;
    }

    if (noteAction === "add") {
      await createRequestNote(id);
      return;
    }

    if (noteAction === "view") {
      await viewRequestNotes(id);
      return;
    }

    if (status) {
      await updateRequestStatus(id, status);
      return;
    }
  } finally {
    button.disabled = false;
  }
});




  </script>
</BaseLayout>
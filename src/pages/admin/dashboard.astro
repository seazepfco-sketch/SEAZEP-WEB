        });

        setLicenseOverviewStatus("Resumen de licencias actualizado.", "success");
      } catch (error) {
        setLicenseOverviewValues({});
        setLicenseOverviewStatus(error.message || "Error al cargar resumen de licencias.", "error");
      }
    }




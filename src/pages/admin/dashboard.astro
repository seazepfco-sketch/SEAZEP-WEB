            headers: {
              "x-admin-key": adminKey
            }
          }),
          fetch(`${ADMIN_LICENSE_ACTIVATIONS_URL}?limit=100`, {
            method: "GET",
            mode: "cors",
            headers: {
              "x-admin-key": adminKey
            }
          }),
          fetch(`${ADMIN_LICENSE_CHECKS_URL}?limit=100`, {
            method: "GET",
            mode: "cors",
            headers: {
              "x-admin-key": adminKey
            }
          }),
          fetch(`${ADMIN_LICENSE_CHECKS_URL}?result=device_limit_reached&limit=100`, {
            method: "GET",
            mode: "cors",
            headers: {
              "x-admin-key": adminKey
            }
          })
        ]);

        const licensesResult = await licensesResponse.json();
        const activationsResult = await activationsResponse.json();
        const checksResult = await checksResponse.json();
        const limitBlocksResult = await limitBlocksResponse.json();

        if (!licensesResponse.ok || !licensesResult.ok) {
          throw new Error(licensesResult.message || "No se pudo cargar licencias.");
        }

        if (!activationsResponse.ok || !activationsResult.ok) {
          throw new Error(activationsResult.message || "No se pudo cargar activaciones.");
        }

        if (!checksResponse.ok || !checksResult.ok) {
          throw new Error(checksResult.message || "No se pudo cargar historial de checks.");

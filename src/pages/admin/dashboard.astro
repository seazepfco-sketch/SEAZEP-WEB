---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionTitle from "../../components/SectionTitle.astro";
---

<BaseLayout title="Panel ADM | SEAZEP">
  <Header active="admin" />

  <main>
    <section class="section">
      <SectionTitle
        eyebrow="ADM SEAZEP"
        title="Panel administrativo de solicitudes."
        text="Consulta interna de solicitudes recibidas desde el formulario público de SEAZEP-WEB."
      />

      <div class="admin-access-panel">
        <div>
          <h3>Acceso temporal ADM</h3>
          <p>
            Ingrese la clave administrativa para consultar las solicitudes registradas.
            Esta clave no se guarda en GitHub.
          </p>
        </div>

        <div class="admin-key-form">
          <input
            class="input"
            id="adminApiKey"
            type="password"
            placeholder="Clave ADM temporal"
            autocomplete="off"
          />



          <section class="admin-filter-panel">
  <div class="admin-filter-header">
    <div>
      <span class="eyebrow">Filtros ADM</span>
      <h3>Seguimiento de solicitudes</h3>
    </div>

    <button class="btn btn-secondary" type="button" id="adminClearFiltersButton">
      Limpiar filtros
    </button>
  </div>

  <div class="admin-filter-grid">
    <label class="admin-filter-field">
      <span>Estado</span>
      <select class="input" id="adminStatusFilter">
        <option value="all">Todos los estados</option>
        <option value="new">Nueva</option>
        <option value="contacted">Contactada</option>
        <option value="negotiation">Negociación</option>
        <option value="closed">Cerrada</option>
        <option value="discarded">Descartada</option>
      </select>
    </label>

    <label class="admin-filter-field">
      <span>Servicio</span>
      <select class="input" id="adminInterestFilter">
        <option value="all">Todos los servicios</option>
        <option value="SmartPozo360">SmartPozo360</option>
        <option value="Diagnóstico electromecánico">Diagnóstico electromecánico</option>
        <option value="Micromedición">Micromedición</option>
        <option value="Macromedición">Macromedición</option>
        <option value="Fugas no visibles">Fugas no visibles</option>
        <option value="Automatización y control">Automatización y control</option>
      </select>
    </label>

    <label class="admin-filter-field admin-filter-search">
      <span>Buscar</span>
      <input
        class="input"
        id="adminSearchInput"
        placeholder="Empresa, responsable, correo, teléfono o mensaje"
      />
    </label>
  </div>

  <div class="admin-summary-grid">
    <article class="admin-summary-card">
      <span>Total</span>
      <strong id="summaryTotal">0</strong>
    </article>

    <article class="admin-summary-card">
      <span>Nuevas</span>
      <strong id="summaryNew">0</strong>
    </article>

    <article class="admin-summary-card">
      <span>Contactadas</span>
      <strong id="summaryContacted">0</strong>
    </article>

    <article class="admin-summary-card">
      <span>Negociación</span>
      <strong id="summaryNegotiation">0</strong>
    </article>

    <article class="admin-summary-card">
      <span>Cerradas</span>
      <strong id="summaryClosed">0</strong>
    </article>

    <article class="admin-summary-card danger">
      <span>Descartadas</span>
      <strong id="summaryDiscarded">0</strong>
    </article>
  </div>
</section>





          <button class="btn btn-primary" id="loadRequestsButton" type="button">
            Cargar solicitudes
          </button>
        </div>

        <p id="adminStatus" class="form-status" aria-live="polite"></p>
      </div>

      <div class="admin-summary-grid">
        <article class="card">
          <span class="eyebrow">Solicitudes</span>
          <h3 id="totalRequests">0</h3>
          <p>Registros recibidos desde el formulario público.</p>
        </article>

        <article class="card">
          <span class="eyebrow">Estado</span>
          <h3 id="newRequests">0</h3>
          <p>Solicitudes nuevas pendientes de seguimiento.</p>
        </article>

        <article class="card">
          <span class="eyebrow">Origen</span>
          <h3>Web</h3>
          <p>Solicitudes capturadas desde SEAZEP-WEB.</p>
        </article>
      </div>

      <section class="admin-requests-section">
        <div class="admin-section-header">
          <div>
            <span class="eyebrow">Solicitudes recientes</span>
            <h2>Registros empresariales recibidos.</h2>
          </div>

          <div class="admin-header-actions">
  <a class="btn btn-ghost" href="/admin/usuarios">
    Gestionar usuarios
  </a>

  <a class="btn btn-ghost" href="/admin/empresas">
    Gestionar empresas
  </a>

  <button class="btn btn-ghost" id="refreshRequestsButton" type="button">
    Actualizar
  </button>
</div>
        </div>

        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Empresa</th>
                <th>Responsable</th>
                <th>Contacto</th>
                <th>Interés</th>
                <th>Estado</th>
                <th>Mensaje</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody id="requestsTableBody">
              <tr>
                <td colspan="8" class="admin-empty">
                  Ingrese la clave ADM y presione “Cargar solicitudes”.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </section>
  </main>

  <Footer />

  <script>
    const ADMIN_REQUESTS_BASE_URL = "https://seazep-api.seazepfco.workers.dev/admin/requests";
const ADMIN_UPDATE_STATUS_URL = "https://seazep-api.seazepfco.workers.dev/admin/requests/update-status";
const ADMIN_REQUEST_NOTES_URL = "https://seazep-api.seazepfco.workers.dev/admin/requests/notes";
const ADMIN_CONVERT_REQUEST_TO_COMPANY_URL = "https://seazep-api.seazepfco.workers.dev/admin/requests/convert-to-company";



    const keyInput = document.getElementById("adminApiKey");
    const loadButton = document.getElementById("loadRequestsButton");
    const refreshButton = document.getElementById("refreshRequestsButton");
    const statusEl = document.getElementById("adminStatus");
    const tableBody = document.getElementById("requestsTableBody");
    const totalRequestsEl = document.getElementById("totalRequests");
    const newRequestsEl = document.getElementById("newRequests");


    const statusFilter = document.getElementById("adminStatusFilter");
const interestFilter = document.getElementById("adminInterestFilter");
const searchInput = document.getElementById("adminSearchInput");
const clearFiltersButton = document.getElementById("adminClearFiltersButton");

const summaryTotal = document.getElementById("summaryTotal");
const summaryNew = document.getElementById("summaryNew");
const summaryContacted = document.getElementById("summaryContacted");
const summaryNegotiation = document.getElementById("summaryNegotiation");
const summaryClosed = document.getElementById("summaryClosed");
const summaryDiscarded = document.getElementById("summaryDiscarded");


    function setStatus(message, type = "") {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.className = type ? `form-status ${type}` : "form-status";
    }

    function escapeHtml(value) {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }



    function buildRequestsUrl() {
  const params = new URLSearchParams();

  params.set("limit", "50");

  const status = String(statusFilter?.value || "all").trim();
  const interestArea = String(interestFilter?.value || "all").trim();
  const search = String(searchInput?.value || "").trim();

  if (status && status !== "all") {
    params.set("status", status);
  }

  if (interestArea && interestArea !== "all") {
    params.set("interestArea", interestArea);
  }

  if (search) {
    params.set("search", search);
  }

  return `${ADMIN_REQUESTS_BASE_URL}?${params.toString()}`;
}

function updateSummary(summary = {}) {
  if (summaryTotal) summaryTotal.textContent = String(summary.total || 0);
  if (summaryNew) summaryNew.textContent = String(summary.new || 0);
  if (summaryContacted) summaryContacted.textContent = String(summary.contacted || 0);
  if (summaryNegotiation) summaryNegotiation.textContent = String(summary.negotiation || 0);
  if (summaryClosed) summaryClosed.textContent = String(summary.closed || 0);
  if (summaryDiscarded) summaryDiscarded.textContent = String(summary.discarded || 0);
}



    function formatDate(value) {
      if (!value) return "N/D";

      const date = new Date(value);

      if (Number.isNaN(date.getTime())) {
        return value;
      }

      return date.toLocaleString("es-MX", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit"
      });
    }

    function renderRequests(requests) {
      if (!tableBody) return;

      if (!requests.length) {
        tableBody.innerHTML = `
          <tr>
            <td colspan="8" class="admin-empty">
              No hay solicitudes registradas.
            </td>
          </tr>
        `;
        return;
      }

      tableBody.innerHTML = requests.map((item) => `
        <tr>
          <td>${escapeHtml(formatDate(item.created_at))}</td>
          <td>
            <strong>${escapeHtml(item.company_name)}</strong>
            <small>${escapeHtml(item.source || "website")}</small>
          </td>
          <td>
            <strong>${escapeHtml(item.contact_name)}</strong>
            <small>${escapeHtml(item.contact_position || "Sin cargo")}</small>
          </td>
          <td>
            <strong>${escapeHtml(item.contact_email)}</strong>
            <small>${escapeHtml(item.contact_phone || "Sin teléfono")}</small>
          </td>
          <td>${escapeHtml(item.interest_area)}</td>
          <td>
            <span class="admin-status-pill status-${escapeHtml(item.status || "new")}">
  ${escapeHtml(getStatusLabel(item.status))}
</span>
          </td>
          <td class="admin-message-cell">${escapeHtml(item.message || "Sin mensaje")}</td>
<td>${buildActionButtons(item)}</td>
        </tr>
      `).join("");
    }


    function getAdminKey() {
  return String(keyInput?.value || "").trim();
}

function getStatusLabel(status) {
  const labels = {
    new: "Nueva",
    contacted: "Contactada",
    negotiation: "Negociación",
    closed: "Cerrada",
    discarded: "Descartada"
  };

  return labels[status] || status || "Nueva";
}

function buildActionButtons(item) {
  const currentStatus = item.status || "new";

  const actions = [
    { status: "contacted", label: "Contactada", className: "info" },
    { status: "negotiation", label: "Negociación", className: "warn" },
    { status: "closed", label: "Cerrar", className: "ok" },
    { status: "discarded", label: "Descartar", className: "danger" }
  ];

  return `
    <div class="admin-action-buttons">
      ${actions.map((action) => `
        <button
          class="admin-mini-btn ${action.className}"
          type="button"
          data-request-id="${escapeHtml(item.id)}"
          data-next-status="${escapeHtml(action.status)}"
          ${currentStatus === action.status ? "disabled" : ""}
        >
          ${escapeHtml(action.label)}
        </button>
      `).join("")}

      <button
        class="admin-mini-btn note"
        type="button"
        data-request-id="${escapeHtml(item.id)}"
        data-note-action="add"
      >
        Agregar nota
      </button>

      <button
        class="admin-mini-btn note"
        type="button"
        data-request-id="${escapeHtml(item.id)}"
        data-note-action="view"
      >
        Ver notas
      </button>

      <button
  class="admin-mini-btn convert"
  type="button"
  data-request-id="${escapeHtml(item.id)}"
  data-request-action="convert-company"
>
  Convertir en empresa
</button>
    </div>
  `;
}




async function updateRequestStatus(id, status) {
  const adminKey = getAdminKey();

  if (!adminKey) {
    setStatus("Ingrese la clave ADM antes de actualizar estados.", "error");
    return;
  }

  if (!id || !status) {
    setStatus("Solicitud o estado no válido.", "error");
    return;
  }

  setStatus("Actualizando estado...");

  try {
    const response = await fetch(ADMIN_UPDATE_STATUS_URL, {
      method: "POST",
      mode: "cors",
      headers: {
        "x-admin-key": adminKey,
        "content-type": "text/plain;charset=UTF-8"
      },
      body: JSON.stringify({
        id,
        status,
        note: "Actualizado desde panel ADM SEAZEP"
      })
    });

    const result = await response.json();

    if (!response.ok || !result.ok) {
      throw new Error(result.message || "No se pudo actualizar el estado.");
    }

    setStatus("Estado actualizado correctamente.", "success");
    await loadRequests();
  } catch (error) {
    setStatus(error.message || "Error al actualizar estado.", "error");
  }

}



    async function createRequestNote(id) {
  const adminKey = getAdminKey();

  if (!adminKey) {
    setStatus("Ingrese la clave ADM antes de agregar notas.", "error");
    return;
  }

  if (!id) {
    setStatus("No se encontró la solicitud seleccionada.", "error");
    return;
  }

  const note = window.prompt("Escriba la nota interna de seguimiento:", "");

  if (note === null) {
    return;
  }

  const cleanNote = String(note || "").trim();

  if (!cleanNote) {
    setStatus("La nota interna no puede estar vacía.", "error");
    return;
  }

  setStatus("Guardando nota interna...");

  try {
    const response = await fetch(ADMIN_REQUEST_NOTES_URL, {
      method: "POST",
      mode: "cors",
      headers: {
        "x-admin-key": adminKey,
        "content-type": "text/plain;charset=UTF-8"
      },
      body: JSON.stringify({
        requestId: id,
        note: cleanNote
      })
    });

    const result = await response.json();

    if (!response.ok || !result.ok) {
      throw new Error(result.message || "No se pudo guardar la nota interna.");
    }

    setStatus("Nota interna registrada correctamente.", "success");
  } catch (error) {
    setStatus(error.message || "Error al guardar nota interna.", "error");
  }
}



    async function viewRequestNotes(id) {
  const adminKey = getAdminKey();

  if (!adminKey) {
    setStatus("Ingrese la clave ADM antes de consultar notas.", "error");
    return;
  }

  if (!id) {
    setStatus("No se encontró la solicitud seleccionada.", "error");
    return;
  }

  setStatus("Consultando notas internas...");

  try {
    const response = await fetch(`${ADMIN_REQUEST_NOTES_URL}?requestId=${encodeURIComponent(id)}`, {
      method: "GET",
      mode: "cors",
      headers: {
        "x-admin-key": adminKey
      }
    });

    const result = await response.json();

    if (!response.ok || !result.ok) {
      throw new Error(result.message || "No se pudieron consultar las notas internas.");
    }

    const notes = result.notes || [];

    if (!notes.length) {
      window.alert("Esta solicitud todavía no tiene notas internas.");
      setStatus("La solicitud no tiene notas internas registradas.", "success");
      return;
    }

    const text = notes.map((item, index) => {
      return `${index + 1}. ${formatDate(item.created_at)}\n${item.note}`;
    }).join("\n\n");

    window.alert(`Notas internas:\n\n${text}`);
    setStatus(`Notas internas cargadas: ${notes.length}`, "success");
  } catch (error) {
    setStatus(error.message || "Error al consultar notas internas.", "error");
  }
}



  async function convertRequestToCompany(requestId) {
  const adminKey = getAdminKey();

  if (!adminKey) {
    setStatus("Ingrese la clave ADM antes de convertir una solicitud.", "error");
    return;
  }

  if (!requestId) {
    setStatus("Solicitud no válida.", "error");
    return;
  }

  const confirmConvert = window.confirm(
    "¿Desea convertir esta solicitud en empresa? La solicitud quedará cerrada y se creará una empresa nueva."
  );

  if (!confirmConvert) {
    return;
  }

  const companyStatus = window.prompt(
    "Escriba el estado inicial de la empresa: lead, active, suspended o archived",
    "lead"
  );

  if (companyStatus === null) {
    return;
  }

  const normalizedCompanyStatus = String(companyStatus || "").trim();

  const allowedStatuses = [
    "lead",
    "active",
    "suspended",
    "archived"
  ];

  if (!allowedStatuses.includes(normalizedCompanyStatus)) {
    setStatus("Estado de empresa no permitido. Use: lead, active, suspended o archived.", "error");
    return;
  }

  const note = window.prompt(
    "Nota opcional para la conversión de solicitud a empresa:",
    "Solicitud convertida en empresa desde panel ADM."
  );

  if (note === null) {
    return;
  }

  setStatus("Convirtiendo solicitud en empresa...");

  try {
    const response = await fetch(ADMIN_CONVERT_REQUEST_TO_COMPANY_URL, {
      method: "POST",
      mode: "cors",
      headers: {
        "x-admin-key": adminKey,
        "content-type": "text/plain;charset=UTF-8"
      },
      body: JSON.stringify({
        requestId,
        companyStatus: normalizedCompanyStatus,
        note
      })
    });

    const result = await response.json();

    if (!response.ok || !result.ok) {
      throw new Error(result.message || "No se pudo convertir la solicitud en empresa.");
    }

    setStatus(
      `Solicitud convertida en empresa correctamente. Empresa ID: ${result.companyId}`,
      "success"
    );

    await loadRequests();
  } catch (error) {
    setStatus(error.message || "Error al convertir solicitud en empresa.", "error");
  }
}





    async function loadRequests() {
  if (!keyInput) return;

  const adminKey = String(keyInput.value || "").trim();

  if (!adminKey) {
    setStatus("Ingrese la clave ADM para cargar solicitudes.", "error");
    return;
  }

  setStatus("Cargando solicitudes...");

  if (loadButton) {
    loadButton.disabled = true;
  }

  if (refreshButton) {
    refreshButton.disabled = true;
  }

  try {
    const response = await fetch(buildRequestsUrl(), {
      method: "GET",
      mode: "cors",
      headers: {
        "x-admin-key": adminKey
      }
    });

    const result = await response.json();

    if (!response.ok || !result.ok) {
      throw new Error(result.message || "No se pudieron cargar las solicitudes.");
    }

    renderRequests(result.requests || []);
    updateSummary(result.summary || {});

    if (totalRequestsEl) {
      totalRequestsEl.textContent = String(result.summary?.total || result.total || 0);
    }

    if (newRequestsEl) {
      newRequestsEl.textContent = String(result.summary?.new || 0);
    }

    setStatus(
      `Solicitudes cargadas: ${result.count || 0} de ${result.total || 0}`,
      "success"
    );
  } catch (error) {
    renderRequests([]);
    updateSummary({});

    if (totalRequestsEl) {
      totalRequestsEl.textContent = "0";
    }

    if (newRequestsEl) {
      newRequestsEl.textContent = "0";
    }

    setStatus(error.message || "Error al cargar solicitudes.", "error");
  } finally {
    if (loadButton) {
      loadButton.disabled = false;
    }

    if (refreshButton) {
      refreshButton.disabled = false;
    }
  }
}



statusFilter?.addEventListener("change", loadRequests);
interestFilter?.addEventListener("change", loadRequests);

searchInput?.addEventListener("keydown", (event) => {
  if (event.key === "Enter") {
    loadRequests();
  }
});

clearFiltersButton?.addEventListener("click", () => {
  if (statusFilter) statusFilter.value = "all";
  if (interestFilter) interestFilter.value = "all";
  if (searchInput) searchInput.value = "";

  loadRequests();
});

    loadButton?.addEventListener("click", loadRequests);
    refreshButton?.addEventListener("click", loadRequests);


    tableBody?.addEventListener("click", async (event) => {
  const button = event.target.closest("[data-request-id]");

  if (!button) return;

  const id = button.dataset.requestId;
  const status = button.dataset.nextStatus;
  const noteAction = button.dataset.noteAction;
  const requestAction = button.dataset.requestAction;

  if (!id) return;

  button.disabled = true;

  try {
    if (requestAction === "convert-company") {
      await convertRequestToCompany(id);
      return;
    }

    if (noteAction === "add") {
      await createRequestNote(id);
      return;
    }

    if (noteAction === "view") {
      await viewRequestNotes(id);
      return;
    }

    if (status) {
      await updateRequestStatus(id, status);
      return;
    }
  } finally {
    button.disabled = false;
  }
});




  </script>
</BaseLayout>
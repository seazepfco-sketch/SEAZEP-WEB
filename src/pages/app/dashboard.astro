---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionTitle from "../../components/SectionTitle.astro";
---

<BaseLayout title="Panel de usuario | SEAZEP">
  <Header />

  <main class="section">
    <SectionTitle
      eyebrow="Panel privado"
      title="Bienvenido al panel de usuario SEAZEP."
      text="Desde este espacio se administrarán los recursos privados, manuales, licencias y accesos autorizados para su empresa."
    />

    <section class="user-dashboard-shell" id="userDashboardShell" hidden>
      <article class="user-profile-card">
        <div>
          <span class="eyebrow">Sesión activa</span>
          <h2 id="dashboardUserName">Usuario SEAZEP</h2>
          <p id="dashboardUserEmail">correo@ejemplo.com</p>
        </div>

        <button class="btn btn-ghost" type="button" id="dashboardLogoutButton">
          Cerrar sesión
        </button>
      </article>

      <div class="user-dashboard-grid">
        <article class="card">
  <span class="eyebrow">Empresa asociada</span>
  <h3 id="dashboardLinkedCompanyName">Sin empresa asociada</h3>
  <p id="dashboardLinkedCompanyStatus">Estado de empresa: N/D</p>
</article>

<article class="card">
  <span class="eyebrow">Empresa declarada</span>
  <h3 id="dashboardCompanyName">Pendiente</h3>
  <p>Empresa escrita por el usuario al registrarse.</p>
</article>


        <article class="card">
          <span class="eyebrow">Teléfono</span>
          <h3 id="dashboardPhone">N/D</h3>
          <p>Dato de contacto registrado por el usuario.</p>
        </article>

        <article class="card">
          <span class="eyebrow">Rol</span>
          <h3 id="dashboardRole">user</h3>
          <p>Tipo de acceso asignado dentro de la plataforma.</p>
        </article>

        <article class="card">
          <span class="eyebrow">Estado</span>
          <h3 id="dashboardStatus">active</h3>
          <p>Solo usuarios activos pueden acceder al panel privado.</p>
        </article>

        <article class="card">
          <span class="eyebrow">Sesión vence</span>
          <h3 id="dashboardExpiresAt">N/D</h3>
          <p>Tiempo máximo de validez de la sesión actual.</p>
        </article>

        <article class="card">
          <span class="eyebrow">Recursos</span>
          <h3>Próximamente</h3>
          <p>En una fase posterior se mostrarán manuales y recursos autorizados.</p>
        </article>
      </div>

      <section class="user-access-note">
        <span class="eyebrow">Siguiente módulo</span>
        <h3>Recursos y manuales privados</h3>
        <p>
          Este panel ya reconoce la sesión real del usuario. El siguiente paso será conectar
          recursos privados, manuales autorizados y permisos por empresa o software.
        </p>
      </section>

      <section class="section user-manuals-section">
  <div class="container">
    <div class="admin-section-header">
      <div>
        <span class="eyebrow">Recursos autorizados</span>
        <h2>Mis manuales disponibles</h2>
        <p>
          Manuales, guías y documentos técnicos habilitados para su empresa asociada.
        </p>
      </div>

      <button class="btn btn-ghost" id="refreshUserManualsButton" type="button">
        Actualizar manuales
      </button>
    </div>

    <p id="userManualsStatus" class="form-status" aria-live="polite"></p>

    <div class="manuals-user-grid" id="userManualsGrid">
      <article class="card">
        <span class="eyebrow">Manuales</span>
        <h3>Cargando recursos...</h3>
        <p>Espere mientras se consultan los manuales autorizados.</p>
      </article>
    </div>
  </div>
</section>

    </section>

    <section class="user-dashboard-shell" id="userDashboardBlocked">
      <article class="user-profile-card">
        <div>
          <span class="eyebrow">Acceso requerido</span>
          <h2>Inicie sesión para continuar.</h2>
          <p>No se encontró una sesión activa válida.</p>
        </div>

        <a class="btn btn-primary" href="/acceso">
          Ir a acceso
        </a>
      </article>
    </section>
  </main>

  <Footer />

  <script>
    const dashboardShell = document.getElementById("userDashboardShell");
    const dashboardBlocked = document.getElementById("userDashboardBlocked");

    const dashboardUserName = document.getElementById("dashboardUserName");
    const dashboardUserEmail = document.getElementById("dashboardUserEmail");
    const dashboardCompanyName = document.getElementById("dashboardCompanyName");
    const userManualsGrid = document.getElementById("userManualsGrid");
    const userManualsStatus = document.getElementById("userManualsStatus");
    const refreshUserManualsButton = document.getElementById("refreshUserManualsButton");
    const dashboardLinkedCompanyName = document.getElementById("dashboardLinkedCompanyName");
    const dashboardLinkedCompanyStatus = document.getElementById("dashboardLinkedCompanyStatus");
    const dashboardPhone = document.getElementById("dashboardPhone");
    const dashboardRole = document.getElementById("dashboardRole");
    const dashboardStatus = document.getElementById("dashboardStatus");
    const dashboardExpiresAt = document.getElementById("dashboardExpiresAt");
    const dashboardLogoutButton = document.getElementById("dashboardLogoutButton");

    function clearSeazepSession() {
      localStorage.removeItem("seazep_user");
      localStorage.removeItem("seazep_session_token");
      localStorage.removeItem("seazep_session_expires_at");
    }


    function getCompanyStatusLabel(status) {
  const labels = {
    lead: "Prospecto",
    active: "Activa",
    suspended: "Suspendida",
    archived: "Archivada"
  };

  return labels[status] || status || "N/D";
}


  function escapeHtml(value) {
  return String(value ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

function getManualVisibilityLabel(visibility) {
  const labels = {
    private: "Privado",
    public: "Público"
  };

  return labels[visibility] || visibility || "Privado";
}

function getManualCategoryLabel(category) {
  return category || "General";
}

function normalizeManualUrl(fileUrl) {
  const url = String(fileUrl || "").trim();

  if (!url) {
    return "";
  }

  return url;
}

function setUserManualsStatus(message, type = "") {
  if (!userManualsStatus) return;

  userManualsStatus.textContent = message;
  userManualsStatus.className = type ? `form-status ${type}` : "form-status";
}

function renderUserManuals(manuals = []) {
  if (!userManualsGrid) return;

  if (!manuals.length) {
    userManualsGrid.innerHTML = `
      <article class="card">
        <span class="eyebrow">Sin manuales</span>
        <h3>No hay manuales disponibles</h3>
        <p>
          Su empresa aún no tiene manuales activos asignados o los recursos están pendientes de autorización.
        </p>
      </article>
    `;
    return;
  }

  userManualsGrid.innerHTML = manuals.map((manual) => {
    const fileUrl = normalizeManualUrl(manual.file_url);
    const hasFile = Boolean(fileUrl);

    return `
      <article class="card user-manual-card">
        <span class="eyebrow">${escapeHtml(getManualCategoryLabel(manual.category))}</span>
        <h3>${escapeHtml(manual.title || "Manual sin título")}</h3>

        <p>
          ${escapeHtml(manual.description || "Manual técnico autorizado para su empresa.")}
        </p>

        <div class="user-manual-meta">
          <span>Versión: ${escapeHtml(manual.version || "N/D")}</span>
          <span>Visibilidad: ${escapeHtml(getManualVisibilityLabel(manual.visibility))}</span>
        </div>

        ${
          hasFile
            ? `<a class="btn btn-primary" href="${escapeHtml(fileUrl)}" target="_blank" rel="noopener noreferrer">
                Abrir manual
              </a>`
            : `<button class="btn btn-secondary" type="button" disabled>
                Archivo no disponible
              </button>`
        }
      </article>
    `;
  }).join("");
}

async function loadUserManuals() {
  const token = localStorage.getItem("seazep_session_token");

  if (!token) {
    setUserManualsStatus("Sesión no encontrada. Inicie sesión nuevamente.", "error");
    renderUserManuals([]);
    return;
  }

  setUserManualsStatus("Consultando manuales autorizados...");

  if (refreshUserManualsButton) {
    refreshUserManualsButton.disabled = true;
  }

  try {
    const response = await fetch("https://seazep-api.seazepfco.workers.dev/user/manuals", {
      method: "GET",
      mode: "cors",
      headers: {
        "authorization": `Bearer ${token}`
      }
    });

    const result = await response.json();

    if (!response.ok || !result.ok) {
      throw new Error(result.message || "No se pudieron cargar los manuales.");
    }

    renderUserManuals(result.manuals || []);

    setUserManualsStatus(
      `Manuales disponibles: ${result.count || 0}`,
      "success"
    );
  } catch (error) {
    renderUserManuals([]);
    setUserManualsStatus(error.message || "Error al cargar manuales.", "error");
  } finally {
    if (refreshUserManualsButton) {
      refreshUserManualsButton.disabled = false;
    }
  }
}




    function formatSessionDate(value) {
      if (!value) return "N/D";

      const date = new Date(value);

      if (Number.isNaN(date.getTime())) {
        return "N/D";
      }

      return date.toLocaleString("es-MX", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit"
      });
    }

    function getSessionData() {
      try {
        const token = localStorage.getItem("seazep_session_token");
        const expiresAt = localStorage.getItem("seazep_session_expires_at");
        const rawUser = localStorage.getItem("seazep_user");

        if (!token || !expiresAt || !rawUser) {
          return null;
        }

        const expiresDate = new Date(expiresAt);

        if (Number.isNaN(expiresDate.getTime()) || expiresDate <= new Date()) {
          clearSeazepSession();
          return null;
        }

        const user = JSON.parse(rawUser);

        if (!user || user.status !== "active") {
          clearSeazepSession();
          return null;
        }

        return {
          token,
          expiresAt,
          user
        };
      } catch {
        clearSeazepSession();
        return null;
      }
    }

    function renderDashboard() {
      const session = getSessionData();

      if (!session) {
        if (dashboardShell) dashboardShell.hidden = true;
        if (dashboardBlocked) dashboardBlocked.hidden = false;

        setTimeout(() => {
          window.location.href = "/acceso";
        }, 1200);

        return;
      }

      const { user, expiresAt } = session;

      if (dashboardUserName) {
        dashboardUserName.textContent = user.fullName || "Usuario SEAZEP";
      }

      if (dashboardUserEmail) {
        dashboardUserEmail.textContent = user.email || "";
      }

      if (dashboardCompanyName) {
        dashboardCompanyName.textContent = user.companyName || "Sin empresa";
      }


      if (dashboardLinkedCompanyName) {
  dashboardLinkedCompanyName.textContent = user.linkedCompanyName || "Sin empresa asociada";
}

if (dashboardLinkedCompanyStatus) {
  dashboardLinkedCompanyStatus.textContent = `Estado de empresa: ${getCompanyStatusLabel(user.linkedCompanyStatus)}`;
}


      if (dashboardPhone) {
        dashboardPhone.textContent = user.phone || "N/D";
      }

      if (dashboardRole) {
        dashboardRole.textContent = user.role || "user";
      }

      if (dashboardStatus) {
        dashboardStatus.textContent = user.status || "active";
      }

      if (dashboardExpiresAt) {
        dashboardExpiresAt.textContent = formatSessionDate(expiresAt);
      }

      if (dashboardShell) dashboardShell.hidden = false;
      if (dashboardBlocked) dashboardBlocked.hidden = true;

        loadUserManuals();
    }

    dashboardLogoutButton?.addEventListener("click", () => {
      clearSeazepSession();
      window.location.href = "/acceso";
    });

     refreshUserManualsButton?.addEventListener("click", loadUserManuals);
     

    renderDashboard();
  </script>
</BaseLayout>
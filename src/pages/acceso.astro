---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionTitle from "../components/SectionTitle.astro";
---

<BaseLayout title="Acceso de usuario | SEAZEP">
  <Header />

  <main class="section form-panel">
    <SectionTitle
      eyebrow="Acceso"
      title="Acceso privado a recursos SEAZEP."
      text="Ingrese con su correo y contraseña. Las cuentas nuevas requieren aprobación administrativa antes de acceder."
    />

    <form class="form-grid" id="loginForm" autocomplete="off">
      <input
  class="input"
  name="email"
  type="email"
  placeholder="Correo electrónico"
  autocomplete="off"
  value=""
  required
/>

      <input
  class="input"
  name="password"
  type="password"
  placeholder="Contraseña"
  autocomplete="new-password"
  value=""
  required
/>

      <!-- Campo oculto antispam. No eliminar. -->
      <input
        type="text"
        name="website"
        autocomplete="off"
        tabindex="-1"
        style="display:none"
      />

      <button class="btn btn-primary" type="submit" id="loginSubmitButton">
        Iniciar sesión
      </button>

      <p id="loginFormStatus" class="form-status" aria-live="polite"></p>
    </form>
  </main>

  <Footer />

  <script>
    const SEAZEP_LOGIN_URL = "https://seazep-api.seazepfco.workers.dev/auth/login";

    const loginForm = document.getElementById("loginForm");
    const loginStatusEl = document.getElementById("loginFormStatus");
    const loginSubmitButton = document.getElementById("loginSubmitButton");

    if (loginForm) {
  loginForm.reset();

  setTimeout(() => {
    loginForm.reset();

    const emailInput = loginForm.querySelector('input[name="email"]');
    const passwordInput = loginForm.querySelector('input[name="password"]');

    if (emailInput) emailInput.value = "";
    if (passwordInput) passwordInput.value = "";
  }, 150);
}

    if (loginForm) {
      loginForm.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!loginStatusEl || !loginSubmitButton) return;

        const formData = new FormData(loginForm);

        const payload = {
          email: String(formData.get("email") || "").trim(),
          password: String(formData.get("password") || ""),
          website: String(formData.get("website") || "").trim()
        };

        loginStatusEl.textContent = "Validando acceso...";
        loginStatusEl.className = "form-status";
        loginSubmitButton.disabled = true;

        try {
          const response = await fetch(SEAZEP_LOGIN_URL, {
            method: "POST",
            mode: "cors",
            headers: {
              "content-type": "text/plain;charset=UTF-8"
            },
            body: JSON.stringify(payload)
          });

          const result = await response.json();

          if (!response.ok || !result.ok) {
            throw new Error(result.message || "No se pudo iniciar sesión.");
          }

          localStorage.setItem("seazep_session_token", result.token);
          localStorage.setItem("seazep_session_expires_at", result.expiresAt);
          localStorage.setItem("seazep_user", JSON.stringify(result.user));

          loginStatusEl.textContent = "Inicio de sesión correcto. Redirigiendo al panel...";
          loginStatusEl.className = "form-status success";

          setTimeout(() => {
            window.location.href = "/app/dashboard";
          }, 900);
        } catch (error) {
          loginStatusEl.textContent = error.message || "Error al iniciar sesión. Intente nuevamente.";
          loginStatusEl.className = "form-status error";
        } finally {
          loginSubmitButton.disabled = false;
        }
      });
    }
  </script>
</BaseLayout>
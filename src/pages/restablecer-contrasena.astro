---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionTitle from "../components/SectionTitle.astro";
---

<BaseLayout title="Restablecer contraseña | SEAZEP">
  <Header />

  <main class="section form-panel">
    <SectionTitle
      eyebrow="Nueva contraseña"
      title="Restablecer contraseña."
      text="Cree una nueva contraseña para recuperar el acceso a su cuenta SEAZEP."
    />

    <form class="form-grid" id="resetPasswordForm" autocomplete="off">
      <input
        class="input"
        name="password"
        type="password"
        placeholder="Nueva contraseña"
        autocomplete="new-password"
        value=""
        minlength="8"
        required
      />

      <input
        class="input"
        name="passwordConfirm"
        type="password"
        placeholder="Confirmar nueva contraseña"
        autocomplete="new-password"
        value=""
        minlength="8"
        required
      />

      <!-- Campo oculto antispam. No eliminar. -->
      <input
        type="text"
        name="website"
        autocomplete="off"
        tabindex="-1"
        style="display:none"
      />

      <button class="btn btn-primary" type="submit" id="resetPasswordSubmitButton">
        Actualizar contraseña
      </button>

      <a class="btn btn-ghost" href="/acceso">
        Volver a acceso
      </a>

      <p id="resetPasswordStatus" class="form-status" aria-live="polite"></p>
    </form>
  </main>

  <Footer />

  <script>
    const SEAZEP_RESET_PASSWORD_URL = "https://seazep-api.seazepfco.workers.dev/auth/reset-password";

    const resetPasswordForm = document.getElementById("resetPasswordForm");
    const resetPasswordStatus = document.getElementById("resetPasswordStatus");
    const resetPasswordSubmitButton = document.getElementById("resetPasswordSubmitButton");

    const pageParams = new URLSearchParams(window.location.search);
    const resetToken = String(pageParams.get("token") || "").trim();

    if (resetPasswordForm) {
      resetPasswordForm.reset();

      setTimeout(() => {
        resetPasswordForm.reset();
      }, 150);
    }

    if (!resetToken && resetPasswordStatus) {
      resetPasswordStatus.textContent = "El enlace de recuperación no contiene un token válido. Solicite un nuevo enlace.";
      resetPasswordStatus.className = "form-status error";

      if (resetPasswordSubmitButton) {
        resetPasswordSubmitButton.disabled = true;
      }
    }

    resetPasswordForm?.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!resetPasswordStatus || !resetPasswordSubmitButton) return;

      if (!resetToken) {
        resetPasswordStatus.textContent = "Token de recuperación no válido.";
        resetPasswordStatus.className = "form-status error";
        return;
      }

      const formData = new FormData(resetPasswordForm);

      const payload = {
        token: resetToken,
        password: String(formData.get("password") || ""),
        passwordConfirm: String(formData.get("passwordConfirm") || ""),
        website: String(formData.get("website") || "").trim()
      };

      resetPasswordStatus.textContent = "Actualizando contraseña...";
      resetPasswordStatus.className = "form-status";
      resetPasswordSubmitButton.disabled = true;

      try {
        const response = await fetch(SEAZEP_RESET_PASSWORD_URL, {
          method: "POST",
          mode: "cors",
          headers: {
            "content-type": "text/plain;charset=UTF-8"
          },
          body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (!response.ok || !result.ok) {
          throw new Error(result.message || "No se pudo restablecer la contraseña.");
        }

        resetPasswordStatus.textContent = result.message || "Contraseña actualizada correctamente. Ya puede iniciar sesión.";
        resetPasswordStatus.className = "form-status success";
        resetPasswordForm.reset();

        setTimeout(() => {
          window.location.href = "/acceso";
        }, 1800);
      } catch (error) {
        resetPasswordStatus.textContent = error.message || "Error al restablecer contraseña.";
        resetPasswordStatus.className = "form-status error";
      } finally {
        resetPasswordSubmitButton.disabled = false;
      }
    });
  </script>
</BaseLayout>
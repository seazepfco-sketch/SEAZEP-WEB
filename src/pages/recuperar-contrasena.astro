---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionTitle from "../components/SectionTitle.astro";
---

<BaseLayout title="Recuperar contraseña | SEAZEP">
  <Header />

  <main class="section form-panel">
    <SectionTitle
      eyebrow="Recuperación"
      title="Recuperar contraseña."
      text="Ingrese el correo registrado. Si existe una cuenta asociada, enviaremos instrucciones para restablecer la contraseña."
    />

    <form class="form-grid" id="forgotPasswordForm" autocomplete="off">
      <input
        class="input"
        name="email"
        type="email"
        placeholder="Correo electrónico registrado"
        autocomplete="off"
        value=""
        required
      />

      <!-- Campo oculto antispam. No eliminar. -->
      <input
        type="text"
        name="website"
        autocomplete="off"
        tabindex="-1"
        style="display:none"
      />

      <button class="btn btn-primary" type="submit" id="forgotPasswordSubmitButton">
        Enviar instrucciones
      </button>

      <a class="btn btn-ghost" href="/acceso">
        Volver a acceso
      </a>

      <p id="forgotPasswordStatus" class="form-status" aria-live="polite"></p>
    </form>
  </main>

  <Footer />

  <script>
    const SEAZEP_FORGOT_PASSWORD_URL = "https://seazep-api.seazepfco.workers.dev/auth/forgot-password";

    const forgotPasswordForm = document.getElementById("forgotPasswordForm");
    const forgotPasswordStatus = document.getElementById("forgotPasswordStatus");
    const forgotPasswordSubmitButton = document.getElementById("forgotPasswordSubmitButton");

    if (forgotPasswordForm) {
      forgotPasswordForm.reset();

      setTimeout(() => {
        forgotPasswordForm.reset();
      }, 150);
    }

    forgotPasswordForm?.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!forgotPasswordStatus || !forgotPasswordSubmitButton) return;

      const formData = new FormData(forgotPasswordForm);

      const payload = {
        email: String(formData.get("email") || "").trim(),
        website: String(formData.get("website") || "").trim()
      };

      forgotPasswordStatus.textContent = "Enviando instrucciones...";
      forgotPasswordStatus.className = "form-status";
      forgotPasswordSubmitButton.disabled = true;

      try {
        const response = await fetch(SEAZEP_FORGOT_PASSWORD_URL, {
          method: "POST",
          mode: "cors",
          headers: {
            "content-type": "text/plain;charset=UTF-8"
          },
          body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (!response.ok || !result.ok) {
          throw new Error(result.message || "No se pudo procesar la solicitud.");
        }

        forgotPasswordStatus.textContent = result.message || "Si el correo está registrado, enviaremos instrucciones de recuperación.";
        forgotPasswordStatus.className = "form-status success";
        forgotPasswordForm.reset();
      } catch (error) {
        forgotPasswordStatus.textContent = error.message || "Error al solicitar recuperación.";
        forgotPasswordStatus.className = "form-status error";
      } finally {
        forgotPasswordSubmitButton.disabled = false;
      }
    });
  </script>
</BaseLayout>
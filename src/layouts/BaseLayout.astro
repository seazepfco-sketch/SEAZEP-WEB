---
import "../styles/global.css";

const {
  title = "SEAZEP Agua y Energía",
  description = "Soluciones técnicas, evaluación operativa, eficiencia electromecánica y software especializado para sistemas de agua y energía."
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  
   <body>
    <div class="page-shell">
      <slot />
    </div>

    <script is:inline src="/assets/seazep-admin-session.js"></script>
  </body>

</html>
